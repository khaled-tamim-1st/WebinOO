---
export interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  level?: 'h1' | 'h2' | 'h3';
  class?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  level: Tag = 'h2',
  class: className = '',
} = Astro.props;
---

<div class={`section-head ${className}`.trim()}>
  {eyebrow && <div class="eyebrow">{eyebrow}</div>}
  {title && <Tag set:html={title} />}
  <slot />
  {subtitle && <p set:html={subtitle} />}
</div>
