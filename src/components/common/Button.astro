---
export interface Props {
  variant?: 'primary' | 'quiet' | 'white';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  target?: string;
  rel?: string;
  ariaLabel?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  class: className = '',
  target,
  rel,
  ariaLabel,
  ...rest
} = Astro.props;

const variantClass = {
  primary: 'button-primary',
  quiet: 'button-quiet',
  white: 'button-white',
}[variant];

const sizeClass = {
  sm: 'button-sm',
  md: '',
  lg: 'button-lg',
}[size];

const classes = `button ${variantClass} ${sizeClass} ${className}`.trim();
---

{
  href ? (
    <a href={href} class={classes} target={target} rel={rel} aria-label={ariaLabel} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} aria-label={ariaLabel} {...rest}>
      <slot />
    </button>
  )
}
