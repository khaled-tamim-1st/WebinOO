---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { ArrowLeft, ChevronDown, Menu, X } from '@lucide/astro';

export interface Props {
  lang?: 'ar' | 'en';
}

const { lang = 'ar' } = Astro.props;

const prefix = lang === 'ar' ? '' : '/en';

const services = [
  { href: `${prefix}/services/web-design-kuwait/`, label: lang === 'ar' ? 'تصميم مواقع الشركات' : 'Corporate Web Design' },
  { href: `${prefix}/services/ecommerce-kuwait/`, label: lang === 'ar' ? 'متاجر إلكترونية' : 'E-Commerce Stores' },
  { href: `${prefix}/services/custom-websites-kuwait/`, label: lang === 'ar' ? 'مواقع برمجية خاصة' : 'Custom Web Apps' },
  { href: `${prefix}/services/seo-kuwait/`, label: lang === 'ar' ? 'تحسين محركات البحث (SEO)' : 'SEO in Kuwait' },
  { href: `${prefix}/services/local-seo-kuwait/`, label: lang === 'ar' ? 'الظهور المحلي وخرائط Google' : 'Local SEO & Maps' },
  { href: `${prefix}/services/geo-ai-search-kuwait/`, label: lang === 'ar' ? 'الظهور في الذكاء الاصطناعي (GEO)' : 'AI Search Optimization' },
  { href: `${prefix}/services/content-writing-kuwait/`, label: lang === 'ar' ? 'صياغة المحتوى المتخصص' : 'Content Writing' },
  { href: `${prefix}/services/hosting-maintenance-kuwait/`, label: lang === 'ar' ? 'الاستضافة والصيانة السريعة' : 'Hosting & Maintenance' },
];

const industries = [
  { href: `${prefix}/industries/interior-design-websites/`, label: lang === 'ar' ? 'الديكور والتصميم الداخلي' : 'Interior Design' },
  { href: `${prefix}/industries/contracting-maintenance-websites/`, label: lang === 'ar' ? 'المقاولات والصيانة' : 'Contracting & Maintenance' },
  { href: `${prefix}/industries/cleaning-companies-websites/`, label: lang === 'ar' ? 'شركات التنظيف' : 'Cleaning Services' },
  { href: `${prefix}/industries/clinics-medical-websites/`, label: lang === 'ar' ? 'العيادات والمراكز الطبية' : 'Clinics & Medical' },
  { href: `${prefix}/industries/restaurants-cafes-websites/`, label: lang === 'ar' ? 'المطاعم والكافيهات' : 'Restaurants & Cafes' },
  { href: `${prefix}/industries/logistics-shipping-websites/`, label: lang === 'ar' ? 'الشحن والنقل اللوجستي' : 'Logistics & Shipping' },
];
---

<header class="topbar-wrapper" id="siteHeader">
  <div class="container topbar">
    <a class="brand" href={lang === 'ar' ? '/' : '/en/'} aria-label={lang === 'ar' ? 'webinOO الصفحة الرئيسية' : 'webinOO Homepage'}>
      <img src="/webinoo-logo.webp" alt="webinOO" width="156" height="58" fetchpriority="high" loading="eager" decoding="async" />
    </a>

    <!-- Desktop Navigation with Interactive Dropdowns -->
    <nav class="navlinks" aria-label={lang === 'ar' ? 'التنقل الرئيسي' : 'Main Navigation'}>
      <div class="nav-item has-dropdown" data-dropdown="services">
        <div class="nav-link-group">
          <a href={`${prefix}/services/`} class="nav-link">
            {lang === 'ar' ? 'خدماتنا' : 'Services'}
          </a>
          <button
            type="button"
            class="dropdown-trigger"
            aria-expanded="false"
            aria-label={lang === 'ar' ? 'عرض قائمة خيارات الخدمات' : 'Toggle Services Menu'}
          >
            <ChevronDown size={14} class="chevron" />
          </button>
        </div>
        <div class="dropdown-menu">
          <div class="dropdown-header">
            <a href={`${prefix}/services/`} class="dropdown-all-link">
              <span>{lang === 'ar' ? 'عرض جميع الخدمات' : 'View All Services'}</span>
              <span class="arrow-sym">{lang === 'ar' ? '←' : '→'}</span>
            </a>
          </div>
          <div class="dropdown-grid">
            {services.map((item) => (
              <a href={item.href} class="dropdown-item">{item.label}</a>
            ))}
          </div>
        </div>
      </div>

      <div class="nav-item has-dropdown" data-dropdown="industries">
        <div class="nav-link-group">
          <a href={`${prefix}/industries/`} class="nav-link">
            {lang === 'ar' ? 'القطاعات' : 'Industries'}
          </a>
          <button
            type="button"
            class="dropdown-trigger"
            aria-expanded="false"
            aria-label={lang === 'ar' ? 'عرض قائمة خيارات القطاعات' : 'Toggle Industries Menu'}
          >
            <ChevronDown size={14} class="chevron" />
          </button>
        </div>
        <div class="dropdown-menu">
          <div class="dropdown-header">
            <a href={`${prefix}/industries/`} class="dropdown-all-link">
              <span>{lang === 'ar' ? 'عرض جميع القطاعات' : 'View All Sectors'}</span>
              <span class="arrow-sym">{lang === 'ar' ? '←' : '→'}</span>
            </a>
          </div>
          <div class="dropdown-grid">
            {industries.map((item) => (
              <a href={item.href} class="dropdown-item">{item.label}</a>
            ))}
          </div>
        </div>
      </div>

      <a href={`${prefix}/areas/`} class="nav-link">{lang === 'ar' ? 'مناطق الكويت' : 'Kuwait Areas'}</a>
      <a href={`${prefix}/portfolio/`} class="nav-link">{lang === 'ar' ? 'أعمالنا' : 'Portfolio'}</a>
      <a href={`${prefix}/pricing/`} class="nav-link">{lang === 'ar' ? 'الأسعار' : 'Pricing'}</a>
      <a href={`${prefix}/blog/`} class="nav-link">{lang === 'ar' ? 'المدونة' : 'Blog'}</a>
      <a href={`${prefix}/about/`} class="nav-link">{lang === 'ar' ? 'عن webinOO' : 'About'}</a>
      <a href={`${prefix}/contact/`} class="nav-link">{lang === 'ar' ? 'تواصل معنا' : 'Contact'}</a>
    </nav>

    <!-- Header Actions -->
    <div class="topbar-actions">
      <LanguageSwitcher />
      <a class="button button-primary cta-btn" href={`${prefix}/contact/`}>
        {lang === 'ar' ? 'خلّنا نبدأ' : "Let's Start"} <ArrowLeft size={16} style={lang === 'en' ? 'transform: rotate(180deg);' : ''} />
      </a>
      
      <!-- Mobile Menu Button -->
      <button
        type="button"
        class="mobile-menu-btn"
        id="mobileMenuToggle"
        aria-expanded="false"
        aria-label={lang === 'ar' ? 'فتح القائمة الرئيسية' : 'Toggle Main Menu'}
      >
        <span class="open-icon"><Menu size={22} /></span>
        <span class="close-icon"><X size={22} /></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu (Outside backdrop-filter constraint) -->
  <div class="mobile-drawer" id="mobileDrawer" aria-hidden="true">
    <nav class="mobile-nav">
      <a href={lang === 'ar' ? '/' : '/en/'} class="mobile-link">{lang === 'ar' ? 'الرئيسية' : 'Home'}</a>
      
      <div class="mobile-group-title">{lang === 'ar' ? 'الخدمات المتخصصة' : 'Specialized Services'}</div>
      <div class="mobile-sublinks-grid">
        {services.map((item) => (
          <a href={item.href} class="mobile-sublink">{item.label}</a>
        ))}
      </div>

      <div class="mobile-group-title">{lang === 'ar' ? 'القطاعات والأنشطة' : 'Target Industries'}</div>
      <div class="mobile-sublinks-grid">
        {industries.map((item) => (
          <a href={item.href} class="mobile-sublink">{item.label}</a>
        ))}
      </div>

      <div class="mobile-group-title">{lang === 'ar' ? 'روابط هامة' : 'Quick Links'}</div>
      <a href={`${prefix}/areas/`} class="mobile-link">{lang === 'ar' ? 'مناطق الكويت' : 'Kuwait Areas'}</a>
      <a href={`${prefix}/portfolio/`} class="mobile-link">{lang === 'ar' ? 'أعمالنا' : 'Portfolio'}</a>
      <a href={`${prefix}/pricing/`} class="mobile-link">{lang === 'ar' ? 'الأسعار والباقات' : 'Pricing & Packages'}</a>
      <a href={`${prefix}/blog/`} class="mobile-link">{lang === 'ar' ? 'المدونة الرقمية' : 'Blog & Guides'}</a>
      <a href={`${prefix}/about/`} class="mobile-link">{lang === 'ar' ? 'عن الشركة' : 'About Us'}</a>
      <a href={`${prefix}/contact/`} class="mobile-link">{lang === 'ar' ? 'تواصل معنا' : 'Contact Us'}</a>

      <div class="mobile-actions">
        <a href={`${prefix}/contact/`} class="button button-primary" style="width: 100%;">
          {lang === 'ar' ? 'خلّنا نبدأ' : "Let's Start"}
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  function initHeaderNavigation() {
    // 1. Mobile Menu Toggle
    const mobileToggle = document.getElementById('mobileMenuToggle');
    const mobileDrawer = document.getElementById('mobileDrawer');
    const headerWrapper = document.getElementById('siteHeader');

    if (mobileToggle && mobileDrawer && headerWrapper) {
      function toggleMobileMenu(open) {
        const isOpen = open !== undefined ? open : !mobileDrawer.classList.contains('is-active');
        mobileToggle.setAttribute('aria-expanded', String(isOpen));
        mobileDrawer.setAttribute('aria-hidden', String(!isOpen));
        
        if (isOpen) {
          mobileDrawer.classList.add('is-active');
          mobileToggle.classList.add('is-open');
          headerWrapper.classList.add('menu-open');
          document.body.style.overflow = 'hidden';
        } else {
          mobileDrawer.classList.remove('is-active');
          mobileToggle.classList.remove('is-open');
          headerWrapper.classList.remove('menu-open');
          document.body.style.overflow = '';
        }
      }

      mobileToggle.onclick = function(e) {
        e.stopPropagation();
        toggleMobileMenu();
      };

      // Close when clicking any link in mobile drawer
      mobileDrawer.querySelectorAll('a').forEach(function(link) {
        link.addEventListener('click', function() {
          toggleMobileMenu(false);
        });
      });
    }

    // 2. Desktop Dropdowns (Services / Industries)
    const dropdownItems = document.querySelectorAll('.has-dropdown');
    dropdownItems.forEach(function(item) {
      const trigger = item.querySelector('.dropdown-trigger');

      if (trigger) {
        trigger.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          const isExpanded = item.classList.contains('is-open');

          // Close all other dropdowns
          dropdownItems.forEach(function(other) {
            if (other !== item) {
              other.classList.remove('is-open');
              const otherTrigger = other.querySelector('.dropdown-trigger');
              if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
            }
          });

          // Toggle current
          if (isExpanded) {
            item.classList.remove('is-open');
            trigger.setAttribute('aria-expanded', 'false');
          } else {
            item.classList.add('is-open');
            trigger.setAttribute('aria-expanded', 'true');
          }
        });
      }
    });

    // Close dropdowns on click outside
    document.addEventListener('click', function(e) {
      dropdownItems.forEach(function(item) {
        if (!item.contains(e.target)) {
          item.classList.remove('is-open');
          const trigger = item.querySelector('.dropdown-trigger');
          if (trigger) trigger.setAttribute('aria-expanded', 'false');
        }
      });
    });

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        dropdownItems.forEach(function(item) {
          item.classList.remove('is-open');
          const trigger = item.querySelector('.dropdown-trigger');
          if (trigger) trigger.setAttribute('aria-expanded', 'false');
        });
        if (mobileDrawer && mobileDrawer.classList.contains('is-active')) {
          mobileToggle && mobileToggle.click();
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderNavigation);
  } else {
    initHeaderNavigation();
  }
</script>

<style>
  .topbar-wrapper {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(248, 246, 241, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(221, 213, 225, 0.6);
    transition: background 0.2s;
  }
  .topbar-wrapper.menu-open {
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    background: #f8f6f1 !important;
  }
  .topbar {
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .brand img {
    width: 156px;
    height: 58px;
    display: block;
    object-fit: cover;
    object-position: center;
    mix-blend-mode: multiply;
  }
  .navlinks {
    display: flex;
    align-items: center;
    gap: 18px;
    font-size: 14px;
  }
  .nav-link {
    text-decoration: none;
    color: var(--color-ink-secondary, #595264);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 8px 4px;
    transition: color 0.2s;
  }
  .nav-link:hover {
    color: var(--color-primary, #6419a9);
  }
  .nav-item {
    position: relative;
  }
  .nav-link-group {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }
  .dropdown-trigger {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 6px 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink-secondary, #595264);
    border-radius: 4px;
    transition: color 0.2s, background-color 0.2s, transform 0.2s;
  }
  .dropdown-trigger:hover {
    color: var(--color-primary, #6419a9);
    background-color: rgba(101, 24, 172, 0.06);
  }
  .nav-item.is-open .chevron,
  .nav-item:hover .chevron {
    transform: rotate(180deg);
  }
  .chevron {
    transition: transform 0.2s ease;
  }

  /* Dropdown Menu */
  .dropdown-menu {
    position: absolute;
    top: calc(100% + 4px);
    inset-inline-start: 0;
    min-width: 290px;
    background: var(--color-bg-card, #fffefa);
    border: 1px solid var(--color-border-subtle, #eee7f0);
    border-radius: var(--radius-md, 20px);
    box-shadow: var(--shadow-floating, 0 28px 65px rgba(74, 35, 99, 0.12));
    padding: 12px;
    display: none;
    z-index: 1100;
  }
  /* Invisible hover bridge */
  .dropdown-menu::before {
    content: "";
    position: absolute;
    top: -10px;
    left: 0;
    right: 0;
    height: 10px;
  }
  .nav-item:hover .dropdown-menu,
  .nav-item:focus-within .dropdown-menu,
  .nav-item.is-open .dropdown-menu {
    display: block;
    animation: menuDrop 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes menuDrop {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .dropdown-header {
    padding: 6px 12px 10px;
    margin-bottom: 6px;
    border-bottom: 1px solid var(--color-border-subtle, #f0eaf3);
  }
  .dropdown-all-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-primary, #6518ac);
    text-decoration: none;
    padding: 4px 6px;
    border-radius: 6px;
    background: var(--color-primary-light, #f7f1fc);
    transition: background 0.15s;
  }
  .dropdown-all-link:hover {
    background: #eedef9;
  }
  .arrow-sym {
    font-size: 14px;
  }

  .dropdown-grid {
    display: grid;
    gap: 4px;
  }
  .dropdown-item {
    padding: 8px 12px;
    border-radius: var(--radius-xs, 8px);
    text-decoration: none;
    color: var(--color-ink-primary, #292239);
    font-size: 13.5px;
    font-weight: 500;
    transition: background 0.15s, color 0.15s;
  }
  .dropdown-item:hover {
    background: var(--color-primary-light, #eee5f5);
    color: var(--color-primary, #6518ac);
  }

  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  
  /* Mobile menu button & drawer */
  .mobile-menu-btn {
    display: none;
    cursor: pointer;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-card, #fffefa);
    border: 1px solid var(--color-border-default, #ddd5e1);
    color: var(--color-ink-primary, #292239);
    transition: background-color 0.2s, border-color 0.2s;
  }
  .mobile-menu-btn:hover {
    border-color: var(--color-primary, #6518ac);
  }
  .close-icon {
    display: none;
  }
  .mobile-menu-btn.is-open .open-icon {
    display: none;
  }
  .mobile-menu-btn.is-open .close-icon {
    display: block;
  }

  .mobile-drawer {
    display: none;
    position: fixed;
    top: 72px;
    inset-inline-start: 0;
    inset-inline-end: 0;
    bottom: 0;
    height: calc(100dvh - 72px);
    background: var(--color-bg-body, #f8f6f1);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 20px 20px 60px;
    z-index: 99999;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
  }
  .mobile-drawer.is-active {
    display: block;
    animation: drawerFadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes drawerFadeIn {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 480px;
    margin: 0 auto;
  }
  .mobile-link {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-ink-primary, #292239);
    text-decoration: none;
    padding: 12px 6px;
    border-bottom: 1px solid var(--color-border-subtle, #eee7f0);
    display: block;
  }
  .mobile-group-title {
    font-size: 12px;
    font-weight: 700;
    color: var(--color-primary, #6518ac);
    margin-top: 16px;
    padding: 0 6px 4px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .mobile-sublinks-grid {
    display: grid;
    gap: 4px;
    padding: 0 4px;
  }
  .mobile-sublink {
    font-size: 14px;
    color: var(--color-ink-secondary, #595264);
    text-decoration: none;
    padding: 8px 12px;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--color-border-subtle, #eee7f0);
    border-radius: 8px;
    transition: background 0.15s, color 0.15s;
  }
  .mobile-sublink:hover {
    background: var(--color-primary-light, #eee5f5);
    color: var(--color-primary, #6518ac);
  }
  .mobile-actions {
    margin-top: 28px;
  }

  @media (max-width: 980px) {
    .navlinks {
      display: none;
    }
    .cta-btn {
      display: none;
    }
    .mobile-menu-btn {
      display: inline-flex;
    }
    .topbar {
      min-height: 72px;
    }
    .brand img {
      width: 132px;
      height: 48px;
    }
  }
</style>
