---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import CTA from '@/components/common/CTA.astro';
import { Shield, Zap, Target, HeartHandshake } from '@lucide/astro';

const breadcrumbs = [
  { label: 'الرئيسية', href: '/' },
  { label: 'عن webinOO' },
];

const values = [
  {
    icon: Target,
    title: 'تركيز حصري على الكويت',
    desc: 'لا نشتت جهودنا في أسواق مختلفة. نحن هنا في الكويت، نفهم طبيعة العميل وسلوك الشراء ومناطق الأعمال من حولي والشويخ إلى السالمية والجهراء.',
  },
  {
    icon: Zap,
    title: 'هندسة برمجية من الصفر',
    desc: 'نرفض ووردبريس والقوالب الجاهزة البطيئة. نكتب كوداً خفيفاً وسريعاً يعيش لسنوات ويحقق أعلى درجات الأمان والسرعة.',
  },
  {
    icon: Shield,
    title: 'سيو حقيقي وذكاء اصطناعي (GEO)',
    desc: 'لا نبيع وعوداً وهمية؛ موقعنا نفسه هو الدليل على قدرتنا على تصدر نتائج البحث والإجابات الذكية بأحدث المعايير العالمية.',
  },
  {
    icon: HeartHandshake,
    title: 'شراكة ووضوح تام',
    desc: 'لا مصطلحات تقنية معقدة تهدف لتشويش العميل. نتحدث معك بلهجة دافئة وبسيطة ونمشي معك خطوة بخطوة حتى نجاح موقعك.',
  },
];
---

<BaseLayout
  title="عن webinOO | ستوديو تصميم المواقع وSEO المتخصص في الكويت"
  description="تعرف على webinOO: ستوديو رقمي كويتي متخصص في بناء مواقع فائقة السرعة واستراتيجيات SEO وGEO الموجهة حصرياً لأعمال وشركات الكويت."
  lang="ar"
>
  <Header slot="header" lang="ar" />

  <main class="about-page">
    <section class="container page-header">
      <Breadcrumbs items={breadcrumbs} />
      <div class="eyebrow">من نحن وفلسفتنا</div>
      <h1>حضور رقمي يليق بمستوى الأعمال في الكويت</h1>
      <p class="page-lead">
        تأسست webinOO كاستجابة مباشرة لمشكلة متكررة لاحظناها في سوق الكويت: شركات ومكاتب متميزة في الواقع، لكن مواقعها على الإنترنت قديمة، بطيئة، ولا تعكس 10% من جودة عملها الحقيقي.
      </p>
    </section>

    <!-- Narrative Section -->
    <section class="container story-section">
      <div class="story-grid">
        <div class="story-text">
          <div class="eyebrow">قصتنا ورؤيتنا</div>
          <h2>لماذا نركز على الكويت فقط؟</h2>
          <p>
            سوق الكويت له خصوصية فريدة لا تفهمها الشركات الخارجية أو الوكالات العابرة للدول. العميل الكويتي سريع القرار إذا ارتاح، دقيق في اختياراته، ويبحث دائماً من هاتفه.
          </p>
          <p>
            نحن نؤمن بأن بناء موقع ناجح لا يتطلب فقط مهارة في التصميم والبرمجة، بل يحتاج إلى فهم عميق: كيف يبحث المواطن والمقيم في الكويت؟ ما هي الكلمات التي تلامس ثقته؟ وكيف يتم توجيهه بسلاسة للواتساب أو الفرع؟
          </p>
          <p>
            لذلك قررنا أن نكون المتخصصين رقم #1 في السوق الكويتي، لنبني أصولاً تسويقية رقمية تفخر بها الشركات وتجني منها أرباحاً حقيقية.
          </p>
        </div>
        
        <div class="story-highlight-card">
          <div class="quote-mark">“</div>
          <p class="quote-text">
            الموقع الإلكتروني مش مجرد لوحة على الإنترنت؛ هو موظف مبيعاتك الشاطر اللي يشرح شغلك بثقة ليل ونهار.
          </p>
          <div class="quote-author">فلسفة عمل webinOO — الكويت</div>
        </div>
      </div>
    </section>

    <!-- Core Values Grid -->
    <section class="container values-section">
      <div class="section-head">
        <div class="eyebrow">مبادئ لا نساوم عليها</div>
        <h2>الأسس التي نبني عليها كل مشروع</h2>
      </div>
      <div class="values-grid">
        {
          values.map((val) => {
            const Icon = val.icon;
            return (
              <div class="value-card">
                <div class="value-icon">
                  <Icon size={24} />
                </div>
                <h3>{val.title}</h3>
                <p>{val.desc}</p>
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- About CTA -->
    <CTA
      eyebrow="خلّنا نكون شريكك التقني الموثوق"
      title="جاهز لنبدأ سوا رحلة نجاح جديدة؟"
      description="احكِ لنا عن شركتك وأهدافك، وخلي الباقي علينا من أول فكرة للموقع الحي."
      ctaText="احجز جلسة تعارف سريعة"
      whatsappMessage="السلام عليكم، حاب أتعرف أكثر على webinOO وأناقش موقع شركتي."
    />
  </main>

  <Footer slot="footer" lang="ar" />
</BaseLayout>

<style>
  .about-page {
    padding: 30px 0 60px;
  }
  .page-header {
    max-width: 820px;
    margin-bottom: 50px;
  }
  .page-header h1 {
    font-size: clamp(34px, 4.5vw, 56px);
    line-height: 1.25;
    letter-spacing: -0.04em;
    margin: 16px 0;
    color: var(--color-ink-primary, #292239);
  }
  .page-lead {
    font-size: 18px;
    line-height: 1.9;
    color: var(--color-ink-muted, #716b7a);
  }
  .story-section {
    margin-bottom: 90px;
  }
  .story-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 60px;
    align-items: center;
  }
  .story-text h2 {
    font-size: clamp(28px, 3.5vw, 42px);
    line-height: 1.3;
    margin: 14px 0 20px;
    color: var(--color-ink-primary, #292239);
  }
  .story-text p {
    font-size: 16px;
    line-height: 1.95;
    color: var(--color-ink-muted, #716b7a);
    margin-bottom: 16px;
  }
  .story-highlight-card {
    background: var(--color-accent-lavender, #d8c3e5);
    border-radius: var(--radius-lg, 24px);
    padding: 48px 36px;
    position: relative;
  }
  .quote-mark {
    font: 700 70px var(--font-latin);
    color: var(--color-primary-text, #6b1eae);
    line-height: 1;
    margin-bottom: -10px;
  }
  .quote-text {
    font-size: 22px;
    line-height: 1.6;
    color: var(--color-ink-primary, #292239);
    font-weight: 600;
    margin-bottom: 24px;
  }
  .quote-author {
    font-size: 13px;
    color: #675575;
    font-weight: 600;
  }
  .values-section {
    margin-bottom: 80px;
  }
  .values-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }
  .value-card {
    background: var(--color-bg-card, #fffefa);
    border: 1px solid var(--color-border-subtle, #eee7f0);
    border-radius: var(--radius-lg, 24px);
    padding: 36px 30px;
    box-shadow: 0 4px 15px rgba(56, 32, 75, 0.03);
  }
  .value-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--color-primary-light, #eee5f5);
    color: var(--color-primary, #6518ac);
    display: grid;
    place-items: center;
    margin-bottom: 20px;
  }
  .value-card h3 {
    font-size: 20px;
    margin-bottom: 12px;
    color: var(--color-ink-primary, #292239);
  }
  .value-card p {
    color: var(--color-ink-muted, #716b7a);
    font-size: 15px;
    line-height: 1.85;
    margin: 0;
  }
  @media (max-width: 850px) {
    .story-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .values-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
