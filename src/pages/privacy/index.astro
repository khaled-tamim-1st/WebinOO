---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import { business } from '@/data/business';
import { ShieldCheck, Lock } from '@lucide/astro';

const breadcrumbs = [
  { label: 'الرئيسية', href: '/' },
  { label: 'سياسة الخصوصية' },
];

const lastUpdated = '8 أكتوبر 2026';
---

<BaseLayout
  title={`سياسة الخصوصية | ${business.name} الكويت`}
  description="سياسة الخصوصية وحماية بيانات العملاء في webinOO الكويت. نلتزم بأعلى معايير السرية والأمان الرقمي لجميع شركائنا وعملائنا."
>
  <Header />

  <main id="main-content" class="legal-page">
    <div class="container breadcrumbs-wrap">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <section class="container legal-hero">
      <div class="hero-badge">حماية البيانات والسرية</div>
      <h1 class="legal-title">سياسة الخصوصية وحماية البيانات</h1>
      <p class="legal-date">آخر تحديث: {lastUpdated}</p>
    </section>

    <section class="container legal-content-section">
      <div class="legal-body">
        <div class="legal-card-intro">
          <ShieldCheck size={28} class="intro-icon" />
          <p>
            في <strong>{business.name}</strong>، نعتبر خصوصية عملائنا وشركائنا في دولة الكويت أولوية قصوى ومسؤولية مهنية نلتزم بها. توضح هذه الوثيقة نوعية البيانات التي نجمعها، كيفية استخدامها، وحقوقك الكاملة فيما يتعلق ببياناتك ومعلومات مشروعك.
          </p>
        </div>

        <article class="legal-section">
          <h2>1. البيانات التي نجمعها</h2>
          <p>نجمع البيانات الأساسية التي تقدمها لنا طواعية عند التواصل معنا لطلب خدمة أو استشارة، وتشمل:</p>
          <ul>
            <li><strong>بيانات التواصل:</strong> الاسم الكريم، رقم الهاتف، رقم الواتساب، وعنوان البريد الإلكتروني.</li>
            <li><strong>بيانات النشاط التجاري:</strong> اسم شركتك أو مشروعك، النطاق الجغرافي داخل الكويت، وأهداف الموقع الإلكتروني المطلوب.</li>
            <li><strong>البيانات التقنية العامة:</strong> بيانات التصفح التحليلية المجهولة الهوية (مثل نوع المتصفح، نظام التشغيل، والصفحات الأكثر زيارة) بهدف تحسين أداء الموقع فقط.</li>
          </ul>
        </article>

        <article class="legal-section">
          <h2>2. الغرض من استخدام البيانات</h2>
          <p>نستخدم معلوماتك حصرياً للأغراض التالية:</p>
          <ul>
            <li>التواصل معك لمناقشة تفاصيل مشروعك وتقديم عروض الأسعار والاستشارات الفنية.</li>
            <li>تنفيذ المشاريع البرمجية وتطوير المواقع وفق الاتفاق التعاقدي المشترك.</li>
            <li>توفير خدمات الدعم الفني، الاستضافة، وتحديثات محركات البحث (SEO).</li>
            <li>تحسين تجربة تصفح موقعنا وقياس سرعة التجاوب.</li>
          </ul>
        </article>

        <article class="legal-section">
          <h2>3. سرية الأعمال وعدم الإفصاح (NDA)</h2>
          <div class="highlight-callout">
            <Lock size={20} class="callout-icon" />
            <p>
              <strong>التزام صارم:</strong> جميع البيانات والمعلومات وأسرار الأعمال واستراتيجيات التسويق التي يشاركها العميل معنا تخضع لسرية تامة. لا نقوم تحت أي ظرف ببيع أو تأجير أو مشاركة بياناتك مع أي طرف ثالث تجاري.
            </p>
          </div>
        </article>

        <article class="legal-section">
          <h2>4. أمان واستضافة البيانات</h2>
          <p>
            نطبق تدابير أمنية تقنية وتنظيمية متقدمة لحماية بياناتك من الوصول غير المصرح به أو التعديل أو التسريب. تشمل تدابيرنا استخدام بروتوكولات التشفير القياسية (HTTPS / SSL) وخوادم استضافة ذات موثوقية عالمية وسجلات أمان مشددة.
          </p>
        </article>

        <article class="legal-section">
          <h2>5. ملفات تعريف الارتباط (Cookies)</h2>
          <p>
            يستخدم موقعنا ملفات تعريف ارتباط وظيفية خفيفة جداً لتحسين سرعة التصفح وتذكر تفضيلاتك (مثل اللغة والمظهر). لا نستخدم ملفات تتبع تطفلية أو أدوات إعادة استهداف تابعة لأطراف ثالثة تضر بخصوصيتك.
          </p>
        </article>

        <article class="legal-section">
          <h2>6. حقوقك كعميل</h2>
          <p>يحق لك في أي وقت:</p>
          <ul>
            <li>طلب نسخة من البيانات الشخصية المحفوظة لدينا عن نشاطك.</li>
            <li>طلب تصحيح أو تعديل أي بيانات غير دقيقة.</li>
            <li>طلب حذف سجلات التواصل وبياناتك بشكل كامل من أنظمتنا متى انتهت العلاقة التعاقدية.</li>
          </ul>
        </article>

        <article class="legal-section">
          <h2>7. التواصل بشأن الخصوصية</h2>
          <p>
            إذا كان لديك أي استفسار أو طلب يتعلق بسياسة الخصوصية أو بياناتك، يمكنك التواصل المباشر مع فريقنا عبر الواتساب على
            <a href={`https://wa.me/${business.whatsappNumber}`} class="legal-link" dir="ltr" target="_blank" rel="noopener noreferrer">{business.phone}</a>
            {business.email && <> أو عبر البريد الإلكتروني: <a href={`mailto:${business.email}`} class="legal-link">{business.email}</a></>}.
          </p>
        </article>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .legal-page {
    padding-bottom: var(--space-20);
  }

  .breadcrumbs-wrap {
    padding-top: var(--space-6);
  }

  .legal-hero {
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
    max-width: 800px;
  }

  .hero-badge {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background: rgba(16, 185, 129, 0.1);
    color: var(--color-accent);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }

  .legal-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }

  .legal-date {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .legal-content-section {
    max-width: 840px;
  }

  .legal-body {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8) var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  @media (max-width: 640px) {
    .legal-body {
      padding: var(--space-6) var(--space-5);
    }
  }

  .legal-card-intro {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-5);
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: var(--radius-lg);
  }

  .intro-icon {
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .legal-card-intro p {
    font-size: var(--font-size-base);
    color: var(--color-text-primary);
    line-height: 1.8;
  }

  .legal-section h2 {
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
    border-right: 3px solid var(--color-accent);
    padding-right: var(--space-3);
  }

  .legal-section p {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: var(--space-3);
  }

  .legal-section ul {
    list-style: disc;
    padding-right: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--color-text-secondary);
    line-height: 1.7;
    font-size: var(--font-size-sm);
  }

  .highlight-callout {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-primary-subtle, #f4eafa);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
  }

  .callout-icon {
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .highlight-callout p {
    margin-bottom: 0;
    font-size: var(--font-size-sm);
  }

  .legal-link {
    color: var(--color-accent);
    text-decoration: underline;
    font-weight: 600;
  }

  .legal-link:hover {
    color: #34d399;
  }
</style>
