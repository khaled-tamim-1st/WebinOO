        </div>

        <!-- Strategic Vision Callout -->
        <div class="philosophy-banner">
          <div class="banner-top">
            <span class="banner-tag">الرؤية الهندسية لسوق الخدمات والمقاولات في الكويت</span>
            <span class="banner-stat">المعايير المعتمدة لعام 2026</span>
