    <!-- Main Content Layout (Article + Sticky Sidebar) -->
    <div class="container case-layout">
      <!-- Article Body -->
      <article class="case-article">
        <!-- Mobile Quick Jump Table of Contents -->
        <details class="mobile-quick-nav">
          <summary>📑 فهرس استعراض المنصة (انتقال سريع)</summary>
          <ul>
            <li><a href="#project-specs">1. بطاقة المواصفات الفنية المعتمدة</a></li>
            <li><a href="#market-dynamics">2. سيكولوجية سوق الأصباغ الكويتي والشرائح المستهدفة</a></li>
            <li><a href="#system-architecture">3. المعمارية الهندسية الخماسية للمنصة</a></li>
            <li><a href="#geo-ai-strategy">4. بنية الذكاء الاصطناعي (GEO) وملفات llms.txt</a></li>
            <li><a href="#keywords-comparison">5. تحليل الكلمات الدلالية ونية الشراء في الكويت</a></li>
            <li><a href="#pricing-benchmarks">6. جدول أسعار الأصباغ بالكويت 2026 (KWD)</a></li>
            <li><a href="#growth-roadmap">7. خارطة طريق التحول الرقمي ومعدل التحويل (CRO)</a></li>
            <li><a href="#faq-aeo">8. أسئلة شائعة حول المنصة والتقنية (AEO)</a></li>
          </ul>
        </details>

        <!-- Section 1: Technical Specs Table -->
        <section class="case-section" id="project-specs">
          <div class="section-tag">بطاقة المشروع والمواصفات المعتمدة</div>
          <h2>المواصفات الفنية والمعمارية لمنصة صباغ الكويت</h2>
          
