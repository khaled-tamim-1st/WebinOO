---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import CTA from '@/components/common/CTA.astro';
import {
  ArrowLeft,
  ShieldCheck,
  Sparkles,
  TrendingUp,
  Bot,
  ShoppingBag,
  Eye,
  BookOpen,
} from '@lucide/astro';

const breadcrumbs = [
  { label: 'الرئيسية', href: '/' },
  { label: 'أعمالنا ودراسات الحالة' },
];

const featuredCaseStudy = {
  title: 'متجر Clash Market السعودي — قصة نمو 8 أضعاف ومبيعات مجانية بدون إعلانات ممولة',
  category: 'دراسة حالة حية · سيو المتاجر والذكاء الاصطناعي',
  scope: 'برمجة متجر مخصص فائق السرعة من الصفر + بنية دلالية من 5 طبقات + تهيئة محركات الذكاء الاصطناعي (GEO)',
  results: '4,270 ظهوراً في Google، و20 عميلاً من ChatGPT، و5 مبيعات مؤكدة لحسابات النخبة عبر الواتساب في أول 30 يوماً فقط.',
  stats: [
    { label: 'ظهور Google الطبيعي', value: '4,270', badge: '×8.1 نمو' },
    { label: 'متوسط الترتيب', value: '7.8', badge: 'الصفحة الأولى' },
    { label: 'ميزات الذكاء الاصطناعي', value: '190', badge: 'AI Overviews' },
    { label: 'مبيعات الواتساب', value: '5 صفقات', badge: '0.00 ريال إعلانات' },
  ],
  studyHref: '/portfolio/clash-market/',
  blogHref: '/blog/clash-market-seo-case-study/',
};

const projects = [
  {
    title: 'نموذج ستوديو دار للتصميم الداخلي',
    category: 'تصميم داخلي ومعمار',
    scope: 'تصميم موقع كامل + تهيئة SEO محلي في الكويت + هوية بصرية',
    results: 'سرعة تحميل 1.2 ثانية وتجربة تصفح غامرة على شاشات الموبايل.',
    badge: 'نموذج تجريبي معتمد',
    isConcept: true,
  },
  {
    title: 'شركة مقاولات وإنشاءات عامة بالكويت',
    category: 'مقاولات وبناء',
    scope: 'بروفايل رقمي + كتالوج قسائم ومشاريع منجزة + طلب مقايسة',
    results: 'هيكلة صفحات للمطلاع وصباح الأحمد ومناطق العمران الحديثة.',
    badge: '[قيد النشر والتحديث]',
    isConcept: false,
  },
  {
    title: 'مركز رعاية وعيادة طبية متخصصة',
    category: 'رعاية صحية وطبية',
    scope: 'حجز مواعيد ذكي + ملفات الأطباء + تهيئة كلمات البحث الطبي في السالمية',
    results: 'تقليل ضغط الاتصالات الهاتفية وزيادة الحجوزات المؤكدة.',
    badge: '[قيد النشر والتحديث]',
    isConcept: false,
  },
  {
    title: 'منصة تجارة إلكترونية وتوصيل سريع',
    category: 'متاجر رقمية',
    scope: 'متجر فائق السرعة + ربط Knet وApple Pay + إشعارات واتساب فورية',
    results: 'إتمام عملية الشراء في أقل من 40 ثانية من الجوال.',
    badge: '[قيد النشر والتحديث]',
    isConcept: false,
  },
];
---

<BaseLayout
  title="أعمالنا ودراسات الحالة | webinOO الكويت"
  description="استعرض نماذج أعمالنا ومشاريعنا المصممة للشركات في الكويت والخليج. جودة حقيقية، سرعة استثنائية، ونتائج قابلة للقياس بالأرقام."
  lang="ar"
>
  <Header slot="header" lang="ar" />

  <main class="portfolio-page">
    <section class="container page-header">
      <Breadcrumbs items={breadcrumbs} />
      <div class="eyebrow">جودة عملية تتحدث عن نفسها</div>
      <h1>أعمال صُممت لتحدث فرقاً حقيقياً في الكويت والخليج</h1>
      <p class="page-lead">
        نحن نؤمن بأن أفضل دليل على كفاءتنا هو جودة عملنا. كل موقع نبنيه يخضع لأعلى معايير السرعة، الأمان، والتوافق مع محركات البحث وإجابات الذكاء الاصطناعي.
      </p>

      <!-- Transparency Notice per Rule 5-ج -->
      <div class="transparency-banner">
        <ShieldCheck size={20} class="banner-icon" />
        <span>
          <strong>ملاحظة شفافية:</strong> ننشر دراسات الحالة مع تفاصيل الأرقام والـ Search Console بعد أخذ موافقة العملاء الخطية لحفظ سرية بياناتهم ومستنداتهم التجارية.
        </span>
      </div>
    </section>

    <!-- Flagship Live Case Study Hero Card -->
    <section class="container featured-section">
      <div class="featured-case-card">
        <div class="featured-head">
          <div class="head-badges">
            <span class="live-pill">
              <span class="pulse-dot"></span> دراسة حالة حية موثقة بالأرقام
            </span>
            <span class="tag-cat">{featuredCaseStudy.category}</span>
          </div>
          <span class="zero-ads-badge">0.00 ريال تكلفة إعلانية</span>
        </div>

        <h2 class="featured-title">{featuredCaseStudy.title}</h2>

        <div class="featured-meta-grid">
          <div class="meta-block">
            <strong>نطاق العمل والهندسة:</strong>
            <p>{featuredCaseStudy.scope}</p>
          </div>
          <div class="meta-block">
            <strong>النتيجة والتحول الرقمي:</strong>
            <p>{featuredCaseStudy.results}</p>
          </div>
        </div>

        <!-- Mini Stats Grid -->
        <div class="featured-stats-grid">
          {featuredCaseStudy.stats.map((s) => (
            <div class="mini-stat-card">
              <div class="stat-top">
                <span class="stat-lbl">{s.label}</span>
                <span class="stat-badge">{s.badge}</span>
              </div>
              <div class="stat-val">{s.value}</div>
            </div>
          ))}
        </div>

        <!-- Featured Actions -->
        <div class="featured-actions">
          <a href={featuredCaseStudy.studyHref} class="btn-showcase-primary">
            استعرض دراسة الحالة التفاعلية الكاملة <ArrowLeft size={16} />
          </a>
          <a href={featuredCaseStudy.blogHref} class="btn-showcase-secondary">
            <BookOpen size={16} /> قراءة التقرير الفني في المدونة
          </a>
        </div>
      </div>
    </section>

    <!-- Other Projects Grid -->
    <section class="container projects-grid-section">
      <div class="section-subheading">
        <h2>نماذج ومشاريع أخرى لعملائنا في الكويت</h2>
        <p>مشاريع متنوعة في قطاعات الديكور، المقاولات، العيادات، والتجارة السريعة.</p>
      </div>

      <div class="projects-grid">
        {
          projects.map((proj) => (
            <article class="project-card">
              <div class="card-badge-line">
                <span class="category-tag">{proj.category}</span>
                <span class="status-tag">{proj.badge}</span>
              </div>
              <h3>{proj.title}</h3>
              <div class="project-meta">
                <div class="meta-row">
                  <strong>نطاق العمل:</strong>
                  <span>{proj.scope}</span>
                </div>
                <div class="meta-row">
                  <strong>النتيجة والهدف:</strong>
                  <span>{proj.results}</span>
                </div>
              </div>
              <div class="project-footer">
                <a href="/contact/" class="inquire-btn">
                  اطلب موقعاً مشابهاً لمشروعك <ArrowLeft size={15} />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Portfolio CTA -->
    <CTA
      eyebrow="مشروعك هو قصة نجاحنا القادمة"
      title="خلّنا نبني موقعاً يليق بنشاطك في الكويت."
      description="تواصل معنا اليوم وسنشاركك عينات ومقترحات تناسب قطاعك التجاري تحديداً."
      ctaText="ابدأ مشروعك معنا"
      whatsappMessage="السلام عليكم، أود الاطلاع على أمثلة أعمال ومناقشة مشروع موقع جديد بنفس أسلوب دراسة حالة Clash Market."
    />
  </main>

  <Footer slot="footer" lang="ar" />
</BaseLayout>

<style>
  .portfolio-page {
    padding: 30px 0 60px;
  }
  .page-header {
    max-width: 820px;
    margin-bottom: 40px;
  }
  .page-header h1 {
    font-size: clamp(34px, 4.5vw, 56px);
    line-height: 1.25;
    letter-spacing: -0.04em;
    margin: 16px 0;
    color: var(--color-ink-primary, #292239);
  }
  .page-lead {
    font-size: 18px;
    line-height: 1.9;
    color: var(--color-ink-muted, #716b7a);
    margin-bottom: 24px;
  }
  .transparency-banner {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #f4eafa;
    border: 1px solid #ebd9f5;
    border-radius: var(--radius-sm, 14px);
    padding: 16px 20px;
    font-size: 14px;
    color: #551c88;
    line-height: 1.7;
  }
  .banner-icon {
    color: var(--color-primary, #6518ac);
    flex-shrink: 0;
  }

  /* Featured Case Study Hero */
  .featured-section {
    margin-bottom: 60px;
  }
  .featured-case-card {
    background: linear-gradient(135deg, #241a2e 0%, #3d145e 100%);
    color: #ffffff;
    border-radius: var(--radius-xl, 30px);
    padding: 44px 48px;
    border: 1px solid rgba(225, 180, 243, 0.25);
    box-shadow: var(--shadow-card, 0 16px 38px rgba(56, 32, 75, 0.09));
    position: relative;
    overflow: hidden;
  }
  .featured-case-card::before {
    content: '';
    position: absolute;
    top: -120px;
    left: -120px;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(240, 121, 86, 0.2) 0%, transparent 70%);
    pointer-events: none;
  }
  .featured-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 18px;
  }
  .head-badges {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .live-pill {
    background: rgba(46, 133, 110, 0.25);
    border: 1px solid rgba(110, 231, 183, 0.4);
    color: #6ee7b7;
    padding: 5px 12px;
    border-radius: var(--radius-pill, 999px);
    font-size: 12px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .pulse-dot {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 10px #10b981;
    animation: pulse 1.8s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }
  .tag-cat {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    padding: 5px 12px;
    border-radius: var(--radius-pill, 999px);
    font-size: 12px;
    font-weight: 600;
  }
  .zero-ads-badge {
    background: rgba(240, 121, 86, 0.25);
    color: var(--color-accent-coral-light, #f5a082);
    padding: 5px 14px;
    border-radius: var(--radius-pill, 999px);
    font-size: 12.5px;
    font-weight: 800;
    font-family: var(--font-latin, sans-serif);
  }
  .featured-title {
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    font-weight: 800;
    line-height: 1.35;
    margin: 0 0 20px;
    color: #ffffff;
  }
  .featured-meta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 28px;
  }
  .meta-block {
    background: rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-md, 20px);
    padding: 16px 20px;
  }
  .meta-block strong {
    display: block;
    color: #e5daf0;
    font-size: 13.5px;
    margin-bottom: 6px;
  }
  .meta-block p {
    margin: 0;
    font-size: 14px;
    line-height: 1.75;
    color: #ffffff;
  }

  /* Mini Stats Grid */
  .featured-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 32px;
  }
  .mini-stat-card {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md, 20px);
    padding: 18px 20px;
    transition: transform 0.2s;
  }
  .mini-stat-card:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.1);
  }
  .stat-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  .stat-lbl {
    font-size: 12px;
    color: #cfc2df;
    font-weight: 600;
  }
  .stat-badge {
    font-size: 11px;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(110, 231, 183, 0.2);
    color: #6ee7b7;
    font-family: var(--font-latin, sans-serif);
    direction: ltr;
  }
  .stat-val {
    font-family: var(--font-latin, sans-serif);
    font-size: clamp(1.6rem, 2.2vw, 2.1rem);
    font-weight: 800;
    color: #ffffff;
    direction: ltr;
    text-align: right;
  }

  .featured-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }
  .btn-showcase-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-primary, #6518ac);
    color: #ffffff;
    padding: 13px 26px;
    border-radius: var(--radius-pill, 999px);
    font-size: 14.5px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 8px 22px rgba(101, 24, 172, 0.4);
    transition: background 0.2s, transform 0.2s;
  }
  .btn-showcase-primary:hover {
    background: var(--color-primary-hover, #4e0d90);
    transform: translateY(-2px);
  }
  .btn-showcase-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    padding: 13px 22px;
    border-radius: var(--radius-pill, 999px);
    font-size: 14.5px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s;
  }
  .btn-showcase-secondary:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  /* Subheading */
  .section-subheading {
    margin-bottom: 24px;
  }
  .section-subheading h2 {
    font-size: 24px;
    font-weight: 800;
    color: var(--color-ink-primary, #292239);
    margin: 0 0 6px;
  }
  .section-subheading p {
    font-size: 15px;
    color: var(--color-ink-muted, #716b7a);
    margin: 0;
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 28px;
    margin-bottom: 70px;
  }
  .project-card {
    background: var(--color-bg-card, #fffefa);
    border: 1px solid var(--color-border-subtle, #eee7f0);
    border-radius: var(--radius-lg, 24px);
    padding: 34px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 4px 15px rgba(56, 32, 75, 0.03);
  }
  .card-badge-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    font-size: 12px;
  }
  .category-tag {
    background: var(--color-primary-light, #eee5f5);
    color: var(--color-primary, #6518ac);
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
  }
  .status-tag {
    color: var(--color-ink-muted, #716b7a);
    font-size: 11px;
  }
  .project-card h3 {
    font-size: 21px;
    margin: 0 0 18px;
    color: var(--color-ink-primary, #292239);
  }
  .project-meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
    font-size: 14px;
    line-height: 1.7;
  }
  .meta-row strong {
    display: block;
    color: var(--color-ink-primary, #292239);
    font-size: 13px;
    margin-bottom: 3px;
  }
  .meta-row span {
    color: var(--color-ink-muted, #716b7a);
  }
  .project-footer {
    padding-top: 18px;
    border-top: 1px solid var(--color-border-subtle, #eee7f0);
  }
  .inquire-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-primary, #6518ac);
    text-decoration: none;
    font-weight: 700;
    font-size: 13px;
    transition: gap 0.2s;
  }
  .inquire-btn:hover {
    gap: 10px;
  }

  /* Responsive Rules */
  @media (max-width: 1024px) {
    .featured-stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .featured-meta-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .featured-case-card {
      padding: 30px 22px;
    }
    .featured-stats-grid {
      grid-template-columns: 1fr;
    }
    .btn-showcase-primary,
    .btn-showcase-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
