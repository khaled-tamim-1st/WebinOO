---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import CTA from '@/components/common/CTA.astro';
import { ArrowLeft, ShieldCheck } from '@lucide/astro';

const breadcrumbs = [
  { label: 'الرئيسية', href: '/' },
  { label: 'أعمالنا ودراسات الحالة' },
];

const projects = [
  {
    title: 'شركة ديمو كلين الكويت — استعراض معمارية الإطلاق والسيو المحلي',
    category: 'خدمات منزلية وسيو محلي',
    scope: 'تطوير منصة Next.js 15 مخصصة + سيو برمجي في 22+ منطقة + أتمتة تليجرام الميدانية',
    results: 'إطلاق معتمد بترخيص وزارة الصحة #14620/2025، وتغطية 35+ صفحة هبوط تخصصية في محافظات الكويت مع ربط فوري لبوت طوارئ الميدان.',
    badge: 'استعراض الإطلاق والمعمارية',
    isConcept: false,
    caseStudyUrl: '/portfolio/demo-clean/',
    isFeatured: true,
  },
  {
    title: 'متجر Clash Market السعودي — دراسة حالة SEO وGEO',
    category: 'تجارة إلكترونية وسيو عضوي',
    scope: 'تطوير متجر مخصص من الصفر + سيو تقني + تهيئة محركات الذكاء الاصطناعي (GEO)',
    results: 'نمو الظهور في Google بمعدل 8.1X (4,270 ظهوراً) و20 زائراً من ChatGPT و5 مبيعات عبر واتساب بميزانية إعلانات 0$.',
    badge: 'دراسة حالة موثقة بالأرقام',
    isConcept: false,
    caseStudyUrl: '/portfolio/clash-market/',
    isFeatured: true,
  },
  {
    title: 'نموذج ستوديو دار للتصميم الداخلي',
    category: 'تصميم داخلي ومعمار',
    scope: 'تصميم موقع كامل + تهيئة SEO محلي في الكويت + هوية بصرية',
    results: 'سرعة تحميل 1.2 ثانية وتجربة تصفح غامرة على شاشات الموبايل.',
    badge: 'نموذج تجريبي معتمد',
    isConcept: true,
    caseStudyUrl: null,
    isFeatured: false,
  },
  {
    title: 'شركة مقاولات وإنشاءات عامة بالكويت',
    category: 'مقاولات وبناء',
    scope: 'بروفايل رقمي + كتالوج قسائم ومشاريع منجزة + طلب مقايسة',
    results: 'هيكلة صفحات للمطلاع وصباح الأحمد ومناطق العمران الحديثة.',
    badge: '[قيد النشر والتحديث]',
    isConcept: false,
    caseStudyUrl: null,
    isFeatured: false,
  },
  {
    title: 'مركز رعاية وعيادة طبية متخصصة',
    category: 'رعاية صحية وطبية',
    scope: 'حجز مواعيد ذكي + ملفات الأطباء + تهيئة كلمات البحث الطبي في السالمية',
    results: 'تقليل ضغط الاتصالات الهاتفية وزيادة الحجوزات المؤكدة.',
    badge: '[قيد النشر والتحديث]',
    isConcept: false,
    caseStudyUrl: null,
    isFeatured: false,
  },
  {
    title: 'منصة تجارة إلكترونية وتوصيل سريع',
    category: 'متاجر رقمية',
    scope: 'متجر فائق السرعة + ربط Knet وApple Pay + إشعارات واتساب فورية',
    results: 'إتمام عملية الشراء في أقل من 40 ثانية من الجوال.',
    badge: '[قيد النشر والتحديث]',
    isConcept: false,
    caseStudyUrl: null,
    isFeatured: false,
  },
];
---

<BaseLayout
  title="أعمالنا ودراسات الحالة | webinOO الكويت"
  description="استعرض نماذج أعمالنا ومشاريعنا ودراسات الحالة المصممة للشركات في الكويت والخليج. جودة هندسية حقيقية، سرعة استثنائية، ونتائج قابلة للقياس."
  lang="ar"
>
  <Header slot="header" lang="ar" />

  <main class="portfolio-page">
    <section class="container page-header">
      <Breadcrumbs items={breadcrumbs} />
      <div class="eyebrow">جودة عملية تتحدث عن نفسها بالأرقام</div>
      <h1>أعمال صُممت لتحدث فرقاً تجارياً حقيقياً في الكويت والخليج</h1>
      <p class="page-lead">
        نحن نؤمن بأن أفضل دليل على كفاءتنا هو جودة عملنا ونتائجه المحققة. كل موقع نبنيه يخضع لأعلى معايير السرعة، الأمان، والتوافق الهندسي مع محركات البحث وأنظمة الذكاء الاصطناعي.
      </p>

      <!-- Transparency Notice -->
      <div class="transparency-banner">
        <ShieldCheck size={20} class="banner-icon" />
        <span>
          <strong>ملاحظة شفافية:</strong> نلتزم بأعلى معايير النزاهة الإحصائية؛ جميع دراسات الحالة المنشورة موثقة بسجلات Search Console الحقيقية دون أرقام مضخمة أو وعود وهمية.
        </span>
      </div>
    </section>

    <!-- Projects Grid -->
    <section class="container projects-grid-section">
      <div class="projects-grid">
        {
          projects.map((proj) => (
            <article class={`project-card ${proj.isFeatured ? 'featured-project' : ''}`}>
              <div class="card-badge-line">
                <span class="category-tag">{proj.category}</span>
                <span class={`status-tag ${proj.isFeatured ? 'status-featured' : ''}`}>
                  {proj.badge}
                </span>
              </div>
              <h2>{proj.title}</h2>
              <div class="project-meta">
                <div class="meta-row">
                  <strong>نطاق العمل:</strong>
                  <span>{proj.scope}</span>
                </div>
                <div class="meta-row">
                  <strong>النتيجة والهدف:</strong>
                  <span>{proj.results}</span>
                </div>
              </div>
              <div class="project-footer">
                {proj.caseStudyUrl ? (
                  <a href={proj.caseStudyUrl} class="case-study-btn">
                    <span>اقرأ دراسة الحالة بالأرقام الموثقة</span>
                    <ArrowLeft size={16} />
                  </a>
                ) : (
                  <a href="/contact/" class="inquire-btn">
                    اطلب موقعاً مشابهاً لمشروعك <ArrowLeft size={15} />
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Portfolio CTA -->
    <CTA
      eyebrow="مشروعك هو قصة نجاحنا القادمة"
      title="خلّنا نبني موقعاً يليق بنشاطك في الكويت."
      description="تواصل معنا اليوم وسنشاركك عينات ومقترحات تناسب قطاعك التجاري تحديداً مع خطة سيو واضحة."
      ctaText="ابدأ مشروعك معنا"
      whatsappMessage="السلام عليكم، أود الاطلاع على دراسات الحالة ومناقشة مشروع موقع جديد لشركتي."
    />
  </main>

  <Footer slot="footer" lang="ar" />
</BaseLayout>

<style>
  .portfolio-page {
    padding: 30px 0 60px;
  }
  .page-header {
    max-width: 860px;
    margin-bottom: 50px;
  }
  .page-header h1 {
    font-size: clamp(34px, 4.5vw, 56px);
    line-height: 1.25;
    letter-spacing: -0.04em;
    margin: 16px 0;
    color: var(--color-ink-primary, #292239);
  }
  .page-lead {
    font-size: 18px;
    line-height: 1.9;
    color: var(--color-ink-muted, #716b7a);
    margin-bottom: 24px;
  }
  .transparency-banner {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #f4eafa;
    border: 1px solid #ebd9f5;
    border-radius: var(--radius-sm, 14px);
    padding: 16px 20px;
    font-size: 14px;
    color: #551c88;
    line-height: 1.7;
  }
  .banner-icon {
    color: var(--color-primary, #6518ac);
    flex-shrink: 0;
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 28px;
    margin-bottom: 70px;
  }
  .project-card {
    background: var(--color-bg-card, #fffefa);
    border: 1px solid var(--color-border-subtle, #eee7f0);
    border-radius: var(--radius-lg, 24px);
    padding: 34px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 4px 15px rgba(56, 32, 75, 0.03);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .project-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(56, 32, 75, 0.06);
  }
  .project-card.featured-project {
    background: linear-gradient(150deg, #ffffff 0%, #fbf6ff 100%);
    border: 1.5px solid rgba(101, 24, 172, 0.4);
    box-shadow: 0 8px 25px rgba(101, 24, 172, 0.07);
  }
  .card-badge-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    font-size: 12px;
  }
  .category-tag {
    background: var(--color-primary-light, #eee5f5);
    color: var(--color-primary, #6518ac);
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
  }
  .status-tag {
    color: var(--color-ink-muted, #716b7a);
    font-size: 11px;
  }
  .status-featured {
    background: #e6f7f2;
    color: #1b7a60;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 6px;
  }
  .project-card h2 {
    font-size: 21px;
    margin-bottom: 18px;
    color: var(--color-ink-primary, #292239);
  }
  .project-meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
    font-size: 14px;
    line-height: 1.7;
  }
  .meta-row strong {
    display: block;
    color: var(--color-ink-primary, #292239);
    font-size: 13px;
    margin-bottom: 3px;
  }
  .meta-row span {
    color: var(--color-ink-muted, #716b7a);
  }
  .project-footer {
    padding-top: 18px;
    border-top: 1px solid var(--color-border-subtle, #eee7f0);
  }
  .inquire-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-primary, #6518ac);
    text-decoration: none;
    font-weight: 700;
    font-size: 13px;
    transition: gap 0.2s;
  }
  .inquire-btn:hover {
    gap: 10px;
  }
  .case-study-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--color-primary, #6518ac);
    color: #ffffff;
    padding: 10px 16px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 700;
    font-size: 13.5px;
    transition: background 0.2s, transform 0.2s;
  }
  .case-study-btn:hover {
    background: var(--color-primary-hover, #4e0d90);
    transform: translateY(-1px);
  }
</style>
