    'inLanguage': 'ar-KW',
    'url': 'https://webinoo.online/portfolio/demo-clean/',
    'datePublished': '2026-10-24T09:00:00+03:00',
    'dateModified': '2026-10-24T09:00:00+03:00',
    'author': {
      '@type': 'Organization',
      'name': 'webinOO',
      'url': 'https://webinoo.online'
    },
    'publisher': {
      '@type': 'Organization',
      'name': 'webinOO',
      'url': 'https://webinoo.online'
    },
    'about': [
