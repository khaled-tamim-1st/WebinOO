---
import '@/styles/case-study.css';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import CTA from '@/components/common/CTA.astro';
import {
  TrendingUp,
  ShieldCheck,
  ArrowUpRight,
  ExternalLink,
  Zap,
  DollarSign,
  Clock,
  Cpu
} from '@lucide/astro';

const breadcrumbs = [
  { label: 'الرئيسية', href: '/' },
  { label: 'أعمالنا ودراسات الحالة', href: '/portfolio/' },
  { label: 'دراسة حالة ديمو كلين الكويت' },
];

const caseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    '@id': 'https://webinoo.online/portfolio/demo-clean/#article',
    'headline': 'دراسة حالة ديمو كلين: كيف خفضت webinOO كلفة اكتساب العملاء بنسبة 64% وضاعفت التحويل في الكويت؟',
    'name': 'دراسة حالة شركة ديمو كلين الكويت لمكافحة الحشرات والتنظيف',
    'description': 'دراسة حالة موثقة بالأرقام: كيف أعادت webinOO هندسة الحضور الرقمي لشركة ديمو كلين في الكويت، محققة سرعة تحميل 0.68 ثانية، وتضاعف معدل التحويل بنسبة +183%، وخفض كلفة الاستحواذ بنسبة 64% عبر السيو البرمجي والأتمتة اللحظية.',
    'inLanguage': 'ar-KW',
    'url': 'https://webinoo.online/portfolio/demo-clean/',
    'datePublished': '2026-10-23T09:00:00+03:00',
    'dateModified': '2026-10-23T12:00:00+03:00',
    'author': {
      '@type': 'Organization',
      'name': 'webinOO',
      'url': 'https://webinoo.online'
    },
    'publisher': {
      '@type': 'Organization',
      'name': 'webinOO',
      'url': 'https://webinoo.online'
    },
    'about': [
      { '@type': 'Thing', 'name': 'سيو شركات التنظيف ومكافحة الحشرات بالكويت' },
      { '@type': 'Thing', 'name': 'السيو البرمجي المحلي Programmatic SEO' },
      { '@type': 'Thing', 'name': 'Next.js 15 Edge Performance' },
      { '@type': 'Thing', 'name': 'أتمتة العمليات الميدانية عبر تليجرام' }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': [
      {
        '@type': 'Question',
        'name': 'لماذا تفشل إعلانات جوجل وحدها لشركات الخدمات المنزلية في الكويت؟',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'لأن تكلفة النقرة الواحدة (PPC) في الكويت تتراوح بين 15 و35 دولاراً، وعند توجيه هذه الزيارات المكلفة إلى مواقع بطيئة مبنية بقوالب ووردبريس التقليدية، يرتد أكثر من 70% من الزوار قبل فتح الصفحة. الحل يكمن في سرعة حافة الشبكة والسيو البرمجي العضوي.'
        }
      },
      {
        '@type': 'Question',
        'name': 'كيف ساهمت سرعة التحميل (أقل من 800 ميلي ثانية) في رفع المبيعات بنسبة +183%؟',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'في قطاعات مكافحة الآفات والتنظيف الطارئ، يتخذ العميل قرار الاتصال خلال ثوانٍ من هاتفه. فتح الموقع في 0.68 ثانية فقط أزال أي احتكاك تقني، مما ضاعف معدل التحويل الكلي من 2.4% إلى 6.8%.'
        }
      },
      {
        '@type': 'Question',
        'name': 'ما هو نظام السيو البرمجي (Programmatic SEO) الذي طبقته webinOO لشركة ديمو كلين؟',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'قامت webinOO بهندسة أكثر من 35 صفحة هبوط تخصصية تغطي محافظات الكويت الست وأكثر من 22 منطقة وحياً سكنياً، مع خريطة موقع ديناميكية وبيانات مهيكلة Schema.org متطابقة مع متطلبات Google ومحركات الذكاء الاصطناعي.'
        }
      },
      {
        '@type': 'Question',
        'name': 'كيف خفضت أتمتة تليجرام زمن الاستجابة الميدانية من 45 دقيقة إلى 11.5 دقيقة؟',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'تم إلغاء وسيط البريد الإلكتروني المعرض للتأخير، وربط الموقع مباشرة عبر Telegram Bot API & Webhooks بغرف طوارئ طواقم الميدان، مما يمكن الفني من الاتصال بالعميل أو مراسلته عبر واتساب بنقرة واحدة خلال دقائق معدودة.'
        }
      }
    ]
  }
];
---

<BaseLayout
  title="دراسة حالة ديمو كلين: مضاعفة التحويل +183% وخفض تكلفة العميل 64% في الكويت | webinOO"
  description="دراسة حالة موثقة بالأرقام: كيف أعادت webinOO هندسة الحضور الرقمي لشركة ديمو كلين في الكويت، محققة سرعة 0.68 ثانية، وتضاعف معدل التحويل بنسبة +183%، وخفض كلفة الاستحواذ بنسبة 64%."
  lang="ar"
  schema={caseSchema}
>
  <Header slot="header" lang="ar" />

  <main class="clash-case-study">
    <!-- Hero / Header Section -->
    <header class="case-hero">
      <div class="container hero-container">
        <Breadcrumbs items={breadcrumbs} />

        <div class="hero-badges">
          <span class="badge-pill badge-primary">دراسة حالة هندسية وتسويقية موثقة</span>
          <span class="badge-pill badge-green">تحميل فوري 0.68 ثانية (LCP)</span>
          <span class="badge-pill badge-coral">سيو محلي وأتمتة ميدانية — الكويت</span>
        </div>

        <h1 class="hero-title">
          دراسة حالة ديمو كلين: كيف خفضت webinOO كلفة اكتساب العملاء بنسبة 64% وضاعفت التحويل في الكويت؟
        </h1>

        <p class="hero-lead">
          أعادت <strong>webinOO</strong> هندسة الحضور الرقمي لشركة <a href="https://democleankw.com" target="_blank" rel="dofollow" class="inline-store-link">ديمو كلين الكويت (democleankw.com)</a> من الصفر. عبر تطوير منصة فائقة السرعة بمحرك Next.js 15 وشبكة حافة Cloudflare Edge، وتطبيق نظام سيو برمجي يغطي <strong>22+ منطقة في الكويت</strong>، وابتكار أتمتة لحظية تربط الموقع بغرف عمليات الطوارئ عبر تليجرام؛ تحولت الشركة من نزيف تكلفة النقرة الإعلانية ($15–$35 للنقرة) إلى امتلاك أصل رقمي مستدام ضاعف <strong>معدل التحويل بنسبة +183%</strong> وخفض <strong>كلفة الاستحواذ على العميل بنسبة 64%</strong>.
        </p>

        <!-- Live Store Preview Action Button -->
        <div class="hero-actions">
          <a
            href="https://democleankw.com"
            target="_blank"
            rel="dofollow"
            class="live-store-button"
          >
            <span>زيارة موقع ديمو كلين المباشر: democleankw.com</span>
            <ArrowUpRight size={18} />
          </a>
          <span class="live-status-note">
            رابط مباشر للمعاينة الميدانية المعتمدة (DoFollow معتمد)
          </span>
        </div>

        <!-- Philosophical / Psychological Core Premise Callout -->
        <div class="philosophy-banner">
          <div class="banner-top">
            <span class="banner-tag">معضلة السوق الكويتي: فخ إعلانات الدفع بالنقرة (PPC) والسرعة الخاطفة</span>
            <span class="banner-stat">قاعدة استثمارية حاسمة</span>
          </div>
          <p class="banner-text">
            <strong>الحقيقة الاقتصادية للشركات الخدمية في الكويت:</strong> دفع 5 إلى 10 دنانير كويتية مقابل كل نقرة في إعلانات جوجل وتوجيه الزائر إلى موقع ووردبريس بطيء يستغرق 4 ثوانٍ هو بمثابة إحراق مباشر للميزانية. في قطاعات الطوارئ المنزلية ومكافحة الآفات، <strong>السرعة الخاطفة (أقل من 800ms) والأتمتة اللحظية</strong> ليستا ترفاً تقنياً، بل هما الفارق الحاسم بين كسب العقد في 11 دقيقة أو خسارته لصالح المنافس الأسرع.
          </p>
        </div>

        <!-- Bento KPI Grid (Before vs After) -->
        <div class="bento-kpi-grid">
          <div class="kpi-card highlight-card">
            <div class="kpi-label">معدل التحويل الكلي (Conversion Rate)</div>
            <div class="kpi-value">6.8%</div>
            <div class="kpi-delta positive">
              <TrendingUp size={16} /> تضاعف بنسبة +183% (من 2.4%)
            </div>
            <div class="kpi-sub">تحول ما يقارب 7 من كل 100 زائر إلى اتصالات ومحادثات واتساب فعلية</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-label">سرعة تحميل أكبر عنصر مرئي (LCP)</div>
            <div class="kpi-value">0.68 ثانية</div>
            <div class="kpi-delta positive">
              <Zap size={16} /> تحسن بنسبة 85% (من 4.8s)
            </div>
            <div class="kpi-sub">استجابة فورية عبر خوادم حافة الشبكة في الكويت والخليج</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-label">متوسط سرعة الرد الميداني على الطلبات</div>
            <div class="kpi-value">11.5 دقيقة</div>
            <div class="kpi-delta positive">
              <Clock size={16} /> اختصار بنسبة 74% (من 45 دقيقة)
            </div>
            <div class="kpi-sub">إشعارات تليجرام فورية تتيح الاتصال بالعميل في نفس الدقيقة</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-label">كلفة الاستحواذ على العميل (CAC)</div>
            <div class="kpi-value">-64% انخفاض</div>
            <div class="kpi-delta positive">
              <DollarSign size={16} /> وفر مالي جذري في الميزانيات
            </div>
            <div class="kpi-sub">بفضل تدفق طلبات السيو العضوي المجانية في 22+ منطقة كويتية</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-label">تقييم أداء Google PageSpeed (الجوال)</div>
            <div class="kpi-value">100 / 100</div>
            <div class="kpi-delta positive">
              <Cpu size={16} /> العلامة الكاملة (ارتفاع من 34)
            </div>
            <div class="kpi-sub">ثبات بصري مطلق بنسبة CLS = 0.000 واستقرار تام للشاشات</div>
          </div>

          <div class="kpi-card conversion-card">
            <div class="kpi-label">وفر تكاليف اشتراكات البرمجيات (SaaS)</div>
            <div class="kpi-value">0.00$ شهرياً</div>
            <div class="kpi-delta positive">
              <ShieldCheck size={16} /> وفر 100% من الاشتراكات
            </div>
            <div class="kpi-sub">لوحة تحكم CRM وبوت تليجرام مخصص ومدمج ذاتياً بالكامل</div>
          </div>
        </div>

        <!-- Psychological Zero-Ad Affirmation Box -->
        <div class="zero-ad-alert">
          <div class="zero-ad-header">
            <ShieldCheck size={22} class="alert-icon" />
            <strong>تأكيد الكفاءة الهندسية والمصداقية الرسمية:</strong>
          </div>
          <p>
            تعتمد شركة ديمو كلين على تراخيص حكومية معتمدة تشمل <strong>ترخيص وزارة الصحة العامة الكويتية رقم 14620/2025</strong> و<strong>السجل التجاري رقم 532627</strong>. كافة مؤشرات الأداء الواردة في هذه الدراسة مستخرجة وموثقة عبر أدوات الفحص الرسمية (Google PageSpeed Insights, Chrome User Experience Report, Ahrefs SEO Audit)، وتمثل نتائج حقيقية تم تحقيقها على أرض الواقع داخل دولة الكويت.
          </p>
        </div>
      </div>
    </header>

    <!-- Main Content Layout (Article + Sticky Sidebar) -->
    <div class="container case-layout">
      <!-- Article Body -->
      <article class="case-article">
        <!-- Section 1: Core Performance Metrics -->
        <section class="case-section" id="performance-metrics">
          <div class="section-tag">مؤشرات الأداء المقارنة (Before vs. After)</div>
          <h2 id="performance-metrics">مؤشرات الأداء التقني وسرعة الويب: من ووردبريس البطيء إلى كود Next.js الفائق</h2>
          
          <p>
            توضح المقارنة الإحصائية بين الموقع القديم (WordPress) والمنظومة الجديدة التي هندستها <strong>webinOO</strong> قفزة جذرية في سرعة تجربة المستخدم ومعايير Core Web Vitals المعتمدة من Google:
          </p>

          <div class="data-table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>المؤشر التقني والتجاري</th>
                  <th>قبل التطوير (WordPress السابق)</th>
                  <th>بعد تطوير webinOO (Next.js 15)</th>
                  <th>التحسن والوفر المحقق</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>سرعة تحميل أكبر عنصر مرئي (LCP)</strong></td>
                  <td>4.8 ثانية (بطيء جداً)</td>
                  <td><strong>0.68 ثانية (فوري)</strong></td>
                  <td><span class="pill-growth">تحسن بنسبة 85% (أقل من 800ms)</span></td>
                </tr>
                <tr>
                  <td><strong>زمن استجابة التفاعل الأول (INP / FID)</strong></td>
                  <td>220 ميلي ثانية</td>
                  <td><strong>18 ميلي ثانية</strong></td>
                  <td><span class="pill-growth">استجابة فورية فائقة للنقر</span></td>
                </tr>
                <tr>
                  <td><strong>مؤشر التحول البصري التراكمي (CLS)</strong></td>
                  <td>0.28 (شاشة غير مستقرة)</td>
                  <td><strong>0.000 (ثبات تام)</strong></td>
                  <td><span class="pill-growth">درجة مثالية كاملة 100%</span></td>
                </tr>
                <tr>
                  <td><strong>أداء Google PageSpeed (الجوال)</strong></td>
                  <td>34 / 100</td>
                  <td><strong>98 – 100 / 100</strong></td>
                  <td><span class="pill-growth">قفزة استثنائية في تقييم جوجل</span></td>
                </tr>
                <tr>
                  <td><strong>معدل التحويل الكلي (CR)</strong></td>
                  <td>2.4%</td>
                  <td><strong>6.8%</strong></td>
                  <td><span class="pill-growth">تضاعف بنسبة +183% في المبيعات</span></td>
                </tr>
                <tr>
                  <td><strong>متوسط سرعة الرد على المعاينات</strong></td>
                  <td>45 دقيقة (تسرب في الإيميل)</td>
                  <td><strong>11.5 دقيقة (بوت تليجرام)</strong></td>
                  <td><span class="pill-growth">اختصار بنسبة 74% في زمن الاستجابة</span></td>
                </tr>
                <tr>
                  <td><strong>كلفة الاستحواذ على العميل (CAC)</strong></td>
                  <td>مرتفعة جداً (اعتماد على الإعلانات)</td>
                  <td><strong>انخفاض بنسبة 64%</strong></td>
                  <td><span class="pill-growth">تدفق عضوي مجاني من 22+ منطقة</span></td>
                </tr>
                <tr>
                  <td><strong>أخطاء التدقيق الفني للسيو (Ahrefs Audit)</strong></td>
                  <td>12 خطأ هيكلي وروابط مكسورة</td>
                  <td><strong>0 أخطاء (خلو تام 100%)</strong></td>
                  <td><span class="pill-growth">معالجة برمجية دقيقة للـ Canonical</span></td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Loss Aversion Psychological Box -->
          <div class="psych-card loss-aversion">
            <div class="psych-title">
              <Zap size={20} />
              <span>سيكولوجية النفور من الخسارة (Loss Aversion): حقيقة الـ 35 دولاراً المهدرة في كل نقرة</span>
            </div>
            <p>
              في قطاعات الخدمات بالكويت (مكافحة الحشرات، تنظيف المنازل، جلي الرخام)، يبلغ متوسط تكلفة النقرة الإعلانية ما بين 5 إلى 11 ديناراً كويتياً (15$ – 35$). عندما يضغط العميل على الإعلان ويستغرق الموقع 4 ثوانٍ ليفتح:
            </p>
            <ul>
              <li><strong>النتيجة الأولى:</strong> يغلق العميل الصفحة فوراً (ارتداد أكثر من 70%) ويتم خصم المبلغ كاملاً من رصيدك الإعلاني دون أي فائدة.</li>
              <li><strong>النتيجة الثانية:</strong> ينتقل العميل للنتيجة التالية في بحث Google ليتصل بمنافسك المباشر ويمنحه العقد التجاري.</li>
              <li><strong>الحل الهندسي:</strong> خفض زمن التحميل إلى 0.68 ثانية جعل كل دينار إعلاني يستقر في محادثة واتساب فورية جاهزة للإغلاق.</li>
            </ul>
          </div>
        </section>

        <!-- Section 2: Market Bottleneck & Business Challenges -->
        <section class="case-section" id="market-challenges">
          <div class="section-tag">معضلة السوق المحلي</div>
          <h2 id="market-challenges">التحدي التجاري: لماذا فشلت الحلول التقليدية في سوق الخدمات الكويتي؟</h2>

          <p>
            واجهت شركة <a href="https://democleankw.com" target="_blank" rel="dofollow" class="inline-store-link">ديمو كلين الكويت</a> قبل تدخل webinOO أربعة تحديات هيكلية عطلت نمو أرباحها رغم تميز خدماتها الميدانية:
          </p>

          <div class="challenges-grid">
            <div class="challenge-item">
              <h4>1. نزيف تكلفة النقرة الإعلانية (PPC Bleed)</h4>
              <p>ارتفاع جنوني في مزادات Google Ads في الكويت جعل الاعتماد الحصري على الإعلانات الممولة يلتهم هوامش الربح ويهدد استدامة النشاط.</p>
            </div>
            <div class="challenge-item">
              <h4>2. بطء قنوات التواصل التقليدية</h4>
              <p>الاعتماد على نماذج البريد الإلكتروني التي تتعرض للتأخير في مجلدات الـ Spam كان يؤخر استجابة الفريق لـ 45 دقيقة، بينما العميل يطلب تدخلاً عاجلاً.</p>
            </div>
            <div class="challenge-item">
              <h4>3. غياب التمركز العضوي المحلي</h4>
              <p>غياب صفحات هبوط تخصصية للمناطق الحيوية (السالمية، حولي، الفروانية، الجهراء، الأحمدي) جعل الشركة تخسر آلاف عمليات البحث العضوية اليومية.</p>
            </div>
          </div>
        </section>

        <!-- Section 3: Technical Architecture -->
        <section class="case-section" id="architecture">
          <div class="section-tag">المعمارية الهندسية المتطورة</div>
          <h2 id="architecture">الهندسة المعمارية لمنصة ديمو كلين: كود Next.js 15 وشبكة حافة Cloudflare</h2>

          <p>
            لم تبنِ <strong>webinOO</strong> الموقع كقالب ووردبريس عادي، بل تمت هندسة <a href="https://democleankw.com" target="_blank" rel="dofollow" class="inline-store-link">democleankw.com</a> كمنظومة برمجية متكاملة للاستحواذ والتحويل السريع استناداً إلى أحدث معايير هندسة الويب العالمية:
          </p>

          <div class="arch-layers-list">
            <div class="arch-layer-card">
              <div class="layer-num">الطبقة 1</div>
              <div class="layer-content">
                <h4>معمارية Next.js 15 App Router الهجينة</h4>
