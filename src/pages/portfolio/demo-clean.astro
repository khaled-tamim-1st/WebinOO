  lang="ar"
  schema={caseSchema}
>
  <Header slot="header" lang="ar" />

  <main class="clash-case-study">
    <!-- Hero / Header Section -->
    <header class="case-hero">
      <div class="container hero-container">
        <Breadcrumbs items={breadcrumbs} />

        <div class="hero-badges">
          <span class="badge-pill badge-primary">بديل إعلانات قوقل المكلفة</span>
