---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import CTA from '@/components/common/CTA.astro';
import { getWhatsAppUrl } from '@/data/business';
import { getCollection } from 'astro:content';
import {
  Calendar,
  Clock,
  ArrowLeft,
  Tag,
  Sparkles,
  BookOpen,
  MessageCircle,
  TrendingUp,
} from '@lucide/astro';

const allPosts = await getCollection('blog');
allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const featuredPost = allPosts[0];

const categories = ['الكل', ...new Set(allPosts.map((p) => p.data.category))];

const breadcrumbs = [
  { label: 'الرئيسية', href: '/' },
  { label: 'المدونة والأدلة المعرفية' },
];

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('ar-KW', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
}

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'مدونة webinOO الرقمية - تصميم مواقع وSEO في الكويت',
  description:
    'مقالات وأدلة عملية متخصصة في تصميم المواقع، تحسين محركات البحث، التجارة الإلكترونية، وتهيئة محركات الذكاء الاصطناعي للأعمال في دولة الكويت.',
  url: 'https://webinoo.online/blog/',
};
---

<BaseLayout
  title="مدونة webinOO الرقمية | أدلة تصميم المواقع والـ SEO والذكاء الاصطناعي في الكويت"
  description="دليلك العملي لفهم تكلفة المواقع، بوابات الدفع كي نت Knet، تصدر خرائط Google، وتهيئة الذكاء الاصطناعي GEO للشركات والمتاجر في الكويت."
  schema={blogSchema}
>
  <Header />

  <main id="main-content" class="blog-hub-page">
    <div class="container breadcrumbs-wrap">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <!-- Hero Section -->
    <section class="container blog-hero">
      <div class="hero-badge">
        <Sparkles size={14} class="badge-icon" />
        <span>مرجع المعرفة الرقمية للأعمال في الكويت 🇰🇼</span>
      </div>
      <h1 class="page-title">
        كل ما تحتاج معرفته عن <span class="highlight-text">المواقع والـ SEO والذكاء الاصطناعي</span> في الكويت.
      </h1>
      <p class="hero-desc">
        أدلة عملية مبنية على واقع السوق الكويتي وسلوك المستهلك المحلي. نساعدك على اتخاذ قرارات تقنية وتسويقية واثقة ومربحة تضمن تصدرك على Google وتوصيات الـ AI.
      </p>

      <!-- Category Filter Tabs -->
      <div class="category-tabs-wrap">
        <div class="category-tabs" id="category-tabs">
          {categories.map((cat, idx) => (
            <button
              type="button"
              class={`cat-tab ${idx === 0 ? 'active' : ''}`}
              data-cat={cat}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- Featured Pillar Guide -->
    {featuredPost && (
      <section class="container featured-post-section" data-category={featuredPost.data.category}>
        <div class="featured-card">
          <div class="featured-content">
            <div class="featured-badge-row">
              <span class="spotlight-tag">
                <TrendingUp size={14} /> الدليل الأكثر شمولاً وتحديثاً
              </span>
              <span class="feat-cat">{featuredPost.data.category}</span>
              <span class="feat-read">
                <Clock size={14} /> {featuredPost.data.readTimeMinutes} دقائق قراءة متعمقة
              </span>
            </div>

            <h2 class="featured-title">
              <a href={`/blog/${featuredPost.id}/`}>
                {featuredPost.data.title.replace(/ \| webinOO$/, '')}
              </a>
            </h2>

            <p class="featured-excerpt">{featuredPost.data.description}</p>

            <div class="featured-tags-row">
              {featuredPost.data.tags.map((tag) => (
                <span class="featured-tag-chip">
                  <Tag size={12} /> {tag}
                </span>
              ))}
            </div>

            <div class="featured-footer">
              <div class="feat-author-info">
                <span class="feat-date">
                  <Calendar size={14} /> {formatDate(featuredPost.data.pubDate)}
                </span>
              </div>
              <a href={`/blog/${featuredPost.id}/`} class="featured-cta-btn">
                <span>قراءة الدليل الشامل</span>
                <ArrowLeft size={16} />
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Articles Grid Section -->
    <section class="container articles-grid-section">
      <div class="section-subhead">
        <BookOpen size={20} class="subhead-icon" />
        <h2>أحدث الأدلة والدراسات المتخصصة</h2>
      </div>

      <div class="articles-grid" id="articles-grid">
        {
          allPosts.map((post) => (
            <article class="article-card" data-category={post.data.category}>
              <div class="card-meta-top">
                <span class="category-badge">{post.data.category}</span>
                <span class="read-time">
                  <Clock size={14} class="meta-icon" />
                  {post.data.readTimeMinutes} د قراءة
                </span>
              </div>

              <h3 class="card-title">
                <a href={`/blog/${post.id}/`}>{post.data.title.replace(/ \| webinOO$/, '')}</a>
              </h3>

              <p class="card-excerpt">{post.data.description}</p>

              <div class="tags-row">
                {post.data.tags.slice(0, 3).map((t) => (
                  <span class="tag-chip">
                    <Tag size={12} class="tag-icon" />
                    {t}
                  </span>
                ))}
              </div>

              <div class="card-footer">
                <span class="pub-date">
                  <Calendar size={14} class="meta-icon" />
                  {formatDate(post.data.pubDate)}
                </span>
                <a
                  href={`/blog/${post.id}/`}
                  class="read-more-link"
                  aria-label={`قراءة مقال ${post.data.title}`}
                >
                  اقرأ الدليل <ArrowLeft size={15} />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Mid-Page Consultation Card -->
    <section class="container consult-banner-section">
      <div class="consult-banner-card">
        <div class="banner-text">
          <span class="banner-pill">
            <Sparkles size={14} /> مساعدة فورية لأصحاب الأعمال
          </span>
          <h3>تبي تدقيق مجاني لحضور شركتك على Google في الكويت؟</h3>
          <p>
            فريق خبراء webinOO يراجع موقعك، ملفك على خرائط Google، ويهيئ نشاطك للظهور في محركات الذكاء الاصطناعي مجاناً وبدون أي التزام.
          </p>
        </div>
        <div class="banner-action">
          <a
            href={getWhatsAppUrl('السلام عليكم، أود طلب تدقيق مجاني لموقعي وحضوري الرقمي في الكويت.')}
            target="_blank"
            rel="noopener noreferrer"
            class="banner-btn"
          >
            <MessageCircle size={18} />
            تحدث مع مستشارنا عبر واتساب
          </a>
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="container cta-wrap">
      <CTA
        title="تبي نطبق هذه الاستراتيجيات على موقع نشاطك؟"
        description="تواصل مع مستشاري webinOO اليوم ودعنا نحدد خطة العمل الأنسب لنمو مشروعك وتصدرك في الكويت."
        buttonText="احجز استشارتك المجانية الآن"
        whatsappMessage="السلام عليكم، قرأت مقالات مدونة webinOO وأود استشارة حول تطبيقها على موقعي."
      />
    </section>
  </main>

  <Footer />

  <!-- Client-side script for category filtering -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const tabs = document.querySelectorAll('.cat-tab');
      const cards = document.querySelectorAll('.article-card');

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          tabs.forEach((t) => t.classList.remove('active'));
          tab.classList.add('active');

          const selectedCat = tab.getAttribute('data-cat');

          cards.forEach((card) => {
            const cardCat = card.getAttribute('data-category');
            if (selectedCat === 'الكل' || cardCat === selectedCat) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    });
  </script>
</BaseLayout>

<style>
  .blog-hub-page {
    padding-bottom: 80px;
    background-color: var(--color-bg-body, #f8f6f1);
  }

  .breadcrumbs-wrap {
    padding-top: 24px;
  }

  .blog-hero {
    padding-top: 36px;
    padding-bottom: 40px;
    max-width: 980px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    background: var(--color-primary-light, #eee5f5);
    color: var(--color-primary, #6518ac);
    border: 1px solid rgba(101, 24, 172, 0.2);
    border-radius: var(--radius-pill, 999px);
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 20px;
  }

  .badge-icon {
    color: var(--color-accent-coral, #f07956);
  }

  .page-title {
    font-size: clamp(2.2rem, 4.2vw, 3.4rem);
    font-weight: 800;
    line-height: 1.28;
    color: var(--color-ink-primary, #292239);
    margin-bottom: 20px;
    letter-spacing: -0.01em;
  }

  .highlight-text {
    background: linear-gradient(135deg, var(--color-primary, #6518ac) 0%, var(--color-accent-coral, #f07956) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-desc {
    font-size: 18px;
    line-height: 1.85;
    color: var(--color-ink-secondary, #595264);
    margin-bottom: 32px;
    max-width: 860px;
  }

  /* Category Tabs */
  .category-tabs-wrap {
    overflow-x: auto;
    padding-bottom: 8px;
  }

  .category-tabs {
    display: flex;
    flex-wrap: nowrap;
    gap: 10px;
  }

  .cat-tab {
    white-space: nowrap;
    padding: 8px 18px;
    background: #ffffff;
    border: 1px solid var(--color-border-default, #ddd5e1);
    border-radius: var(--radius-pill, 999px);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-ink-secondary, #595264);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .cat-tab:hover {
    border-color: var(--color-primary, #6518ac);
    color: var(--color-primary, #6518ac);
    background: var(--color-primary-subtle, #f4eafa);
  }

  .cat-tab.active {
    background: var(--color-primary, #6518ac);
    color: #ffffff;
    border-color: var(--color-primary, #6518ac);
    box-shadow: 0 4px 12px rgba(101, 24, 172, 0.25);
  }

  /* Featured Post Card */
  .featured-post-section {
    margin-bottom: 56px;
  }

  .featured-card {
    background: linear-gradient(135deg, #ffffff 0%, var(--color-bg-card, #fffefa) 100%);
    border: 2px solid var(--color-primary-light, #eee5f5);
    border-radius: var(--radius-xl, 30px);
    padding: 44px;
    box-shadow: 0 16px 40px rgba(56, 32, 75, 0.06);
    position: relative;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .featured-card::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 6px;
    background: linear-gradient(90deg, var(--color-primary, #6518ac), var(--color-accent-coral, #f07956));
  }

  @media (max-width: 640px) {
    .featured-card {
      padding: 28px 20px;
    }
  }

  .featured-badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .spotlight-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(240, 121, 86, 0.15);
    color: #c94f29;
    padding: 4px 14px;
    border-radius: var(--radius-pill, 999px);
    font-size: 12.5px;
    font-weight: 700;
  }

  .feat-cat {
    padding: 4px 14px;
    background: var(--color-primary-light, #eee5f5);
    color: var(--color-primary, #6518ac);
    border-radius: var(--radius-pill, 999px);
    font-size: 12.5px;
    font-weight: 700;
  }

  .feat-read {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--color-ink-muted, #716b7a);
  }

  .featured-title {
    font-size: clamp(1.6rem, 2.8vw, 2.3rem);
    font-weight: 800;
    line-height: 1.35;
    margin-bottom: 16px;
  }

  .featured-title a {
    color: var(--color-ink-primary, #292239);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .featured-title a:hover {
    color: var(--color-primary, #6518ac);
  }

  .featured-excerpt {
    font-size: 16.5px;
    line-height: 1.85;
    color: var(--color-ink-secondary, #595264);
    margin-bottom: 24px;
    max-width: 900px;
  }

  .featured-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }

  .featured-tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    background: var(--color-bg-body, #f8f6f1);
    border: 1px solid var(--color-border-default, #ddd5e1);
    border-radius: var(--radius-pill, 999px);
    font-size: 12px;
    color: var(--color-ink-muted, #716b7a);
  }

  .featured-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border-subtle, #eee7f0);
  }

  .feat-date {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    color: var(--color-ink-muted, #716b7a);
  }

  .featured-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: var(--color-primary, #6518ac);
    color: #ffffff;
    text-decoration: none;
    border-radius: var(--radius-pill, 999px);
    font-size: 14px;
    font-weight: 700;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(101, 24, 172, 0.25);
  }

  .featured-cta-btn:hover {
    background: var(--color-primary-hover, #4e0d90);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(101, 24, 172, 0.35);
  }

  /* Articles Grid */
  .articles-grid-section {
    margin-bottom: 64px;
  }

  .section-subhead {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 28px;
  }

  .subhead-icon {
    color: var(--color-primary, #6518ac);
  }

  .section-subhead h2 {
    font-size: 22px;
    font-weight: 800;
    color: var(--color-ink-primary, #292239);
    margin: 0;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }

  @media (min-width: 640px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .article-card {
    background: var(--color-bg-card, #fffefa);
    border: 1px solid var(--color-border-default, #ddd5e1);
    border-radius: var(--radius-xl, 30px);
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.25s ease;
    box-shadow: 0 4px 16px rgba(56, 32, 75, 0.03);
  }

  .article-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-primary, #6518ac);
    box-shadow: 0 14px 30px rgba(101, 24, 172, 0.1);
  }

  .card-meta-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .category-badge {
    font-size: 12px;
    font-weight: 700;
    color: var(--color-primary, #6518ac);
    background: var(--color-primary-light, #eee5f5);
    padding: 4px 12px;
    border-radius: var(--radius-pill, 999px);
  }

  .read-time {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 12.5px;
    color: var(--color-ink-muted, #716b7a);
  }

  .meta-icon {
    color: var(--color-ink-muted, #716b7a);
  }

  .card-title {
    font-size: 18px;
    font-weight: 800;
    line-height: 1.45;
    margin-bottom: 12px;
  }

  .card-title a {
    color: var(--color-ink-primary, #292239);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .card-title a:hover {
    color: var(--color-primary, #6518ac);
  }

  .card-excerpt {
    font-size: 14.5px;
    color: var(--color-ink-secondary, #595264);
    line-height: 1.75;
    margin-bottom: 20px;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 22px;
  }

  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    background: var(--color-bg-body, #f8f6f1);
    border: 1px solid var(--color-border-subtle, #eee7f0);
    border-radius: var(--radius-pill, 999px);
    font-size: 11.5px;
    color: var(--color-ink-muted, #716b7a);
  }

  .tag-icon {
    color: var(--color-primary, #6518ac);
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid var(--color-border-subtle, #eee7f0);
  }

  .pub-date {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    color: var(--color-ink-muted, #716b7a);
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--color-primary, #6518ac);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .read-more-link:hover {
    color: var(--color-primary-hover, #4e0d90);
    transform: translateX(-3px);
  }

  /* Mid-Page Consultation Banner */
  .consult-banner-section {
    margin-bottom: 64px;
  }

  .consult-banner-card {
    background: linear-gradient(135deg, var(--color-primary-dark, #3b0970) 0%, #20073e 100%);
    border-radius: var(--radius-xl, 30px);
    padding: 40px 48px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    box-shadow: 0 16px 40px rgba(59, 9, 112, 0.25);
  }

  @media (max-width: 768px) {
    .consult-banner-card {
      padding: 32px 24px;
    }
  }

  .banner-text {
    max-width: 650px;
  }

  .banner-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(240, 121, 86, 0.25);
    color: var(--color-accent-coral-light, #f5a082);
    padding: 4px 12px;
    border-radius: var(--radius-pill, 999px);
    font-size: 12.5px;
    font-weight: 700;
    margin-bottom: 14px;
  }

  .banner-text h3 {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 12px;
    line-height: 1.35;
  }

  .banner-text p {
    font-size: 15px;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
  }

  .banner-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 26px;
    background: #25d366;
    color: #ffffff;
    text-decoration: none;
    border-radius: var(--radius-pill, 999px);
    font-size: 15px;
    font-weight: 700;
    box-shadow: 0 6px 18px rgba(37, 211, 102, 0.35);
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .banner-btn:hover {
    background: #1eb856;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(37, 211, 102, 0.45);
  }

  .cta-wrap {
    margin-top: 32px;
  }
</style>
