---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import CTA from '@/components/common/CTA.astro';
import { getCollection } from 'astro:content';
import { ArrowLeft, ArrowUpLeft, CircleCheck } from '@lucide/astro';

const services = await getCollection('services');
services.sort((a, b) => a.data.order - b.data.order);

const breadcrumbs = [
  { label: 'الرئيسية', href: '/' },
  { label: 'خدماتنا في الكويت' },
];
---

<BaseLayout
  title="خدمات تصميم المواقع والـ SEO في الكويت | webinOO"
  description="تعرف على خدمات webinOO في الكويت: تصميم وتطوير مواقع الشركات، المتاجر الإلكترونية، تحسين محركات البحث SEO، والظهور في الذكاء الاصطناعي GEO."
  lang="ar"
>
  <Header slot="header" lang="ar" />

  <main class="services-hub">
    <!-- Hub Header -->
    <section class="container hub-header">
      <Breadcrumbs items={breadcrumbs} />
      <div class="eyebrow">كل ما يحتاجه حضورك الرقمي في الكويت</div>
      <h1>خدمات متكاملة تبني حضورك… وتحوّل الباحثين لعملاء.</h1>
      <p class="hub-desc">
        في webinOO لا نقدم مجرد تصميم مواقع تقليدي. نحن نبني أصولاً تسويقية متكاملة تجعل شركتك في الكويت تظهر في نتائج بحث Google الأولى، تجيب عن أسئلة نماذج الذكاء الاصطناعي، وتمنح عميلك تجربة تصفح سريعة ومقنعة.
      </p>
    </section>

    <!-- Services Grid -->
    <section class="container services-grid-section">
      <div class="services-grid">
        {
          services.map((service, index) => {
            const num = String(index + 1).padStart(2, '0');
            return (
              <article class="service-card">
                <div class="card-top">
                  <span class="card-num">{num}</span>
                  <a href={`/services/${service.id}/`} class="card-arrow" aria-label={`تفاصيل ${service.data.shortTitle}`}>
                    <ArrowUpLeft size={18} />
                  </a>
                </div>
                <h2>
                  <a href={`/services/${service.id}/`}>{service.data.shortTitle}</a>
                </h2>
                <p class="card-desc">{service.data.description}</p>
                <div class="card-deliverables">
                  {service.data.deliverables.slice(0, 3).map((item) => (
                    <div class="deliverable-item">
                      <CircleCheck size={15} class="check-icon" />
                      <span>{item}</span>
                    </div>
                  ))}
                </div>
                <div class="card-footer">
                  <a href={`/services/${service.id}/`} class="more-link">
                    اكتشف تفاصيل الخدمة <ArrowLeft size={15} />
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </section>

    <!-- Bottom CTA -->
    <CTA
      eyebrow="محتار أي خدمة تناسب مشروعك؟"
      title="خلّنا نحدد خطتك معاً."
      description="تواصل معنا وسنقترح عليك الباقة والخطوات الأنسب لطبيعة نشاطك التجاري في الكويت وميزانيتك."
      ctaText="احصل على استشارة سريعة"
      whatsappMessage="السلام عليكم، أرغب في استشارة حول الخدمات الأنسب لنشاطي في الكويت."
    />
  </main>

  <Footer slot="footer" lang="ar" />
</BaseLayout>

<style>
  .services-hub {
    padding: 30px 0 60px;
  }
  .hub-header {
    max-width: 820px;
    margin-bottom: 50px;
  }
  .hub-header h1 {
    font-size: clamp(34px, 4.5vw, 56px);
    line-height: 1.25;
    letter-spacing: -0.04em;
    margin: 16px 0;
    color: var(--color-ink-primary, #292239);
  }
  .hub-desc {
    font-size: 17px;
    line-height: 1.9;
    color: var(--color-ink-muted, #716b7a);
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 28px;
    margin-bottom: 70px;
  }
  .service-card {
    background: var(--color-bg-card, #fffefa);
    border: 1px solid var(--color-border-subtle, #eee7f0);
    border-radius: var(--radius-lg, 24px);
    padding: 34px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s, border-color 0.25s;
    box-shadow: 0 4px 15px rgba(56, 32, 75, 0.03);
  }
  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card, 0 16px 38px rgba(56, 32, 75, 0.09));
    border-color: var(--color-border-default, #ddd5e1);
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }
  .card-num {
    font: 700 14px var(--font-latin);
    color: var(--color-primary-text, #6b1eae);
    background: var(--color-primary-light, #eee5f5);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
  }
  .card-arrow {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--color-border-default, #ddd5e1);
    display: grid;
    place-items: center;
    color: var(--color-primary, #6518ac);
    text-decoration: none;
    transition: all 0.2s;
  }
  .service-card:hover .card-arrow {
    background: var(--color-primary, #6518ac);
    color: #ffffff;
    border-color: var(--color-primary, #6518ac);
  }
  .service-card h2 {
    font-size: 22px;
    margin: 0 0 12px;
  }
  .service-card h2 a {
    color: var(--color-ink-primary, #292239);
    text-decoration: none;
    transition: color 0.2s;
  }
  .service-card h2 a:hover {
    color: var(--color-primary, #6518ac);
  }
  .card-desc {
    color: var(--color-ink-muted, #716b7a);
    font-size: 14px;
    line-height: 1.8;
    margin-bottom: 24px;
  }
  .card-deliverables {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 0;
    border-top: 1px solid var(--color-border-subtle, #eee7f0);
    margin-bottom: 20px;
  }
  .deliverable-item {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    font-size: 13px;
    color: var(--color-ink-secondary, #595264);
  }
  .check-icon {
    color: var(--color-accent-green, #66a28b);
    flex-shrink: 0;
    margin-top: 3px;
  }
  .card-footer {
    padding-top: 16px;
    border-top: 1px solid var(--color-border-subtle, #eee7f0);
  }
  .more-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-primary, #6518ac);
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    transition: gap 0.2s;
  }
  .more-link:hover {
    gap: 10px;
  }
  @media (max-width: 600px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
