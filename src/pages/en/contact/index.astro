---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import FAQ from '@/components/common/FAQ.astro';
import { business, getWhatsAppUrl } from '@/data/business';
import { Phone, Mail, MapPin, Clock, MessageSquare, Send, ShieldCheck } from '@lucide/astro';

const breadcrumbs = [
  { label: 'Home', href: '/en/' },
  { label: 'Contact Us' },
];

const contactFaqs = [
  {
    question: 'What is the fastest way to get in touch with webinOO?',
    answer: 'The fastest method is messaging our team directly on WhatsApp at ' + business.phone + '. We respond within minutes during regular business hours to discuss your project directly.',
  },
  {
    question: 'How long does it take to receive a detailed proposal?',
    answer: 'Following our initial discovery conversation, we provide a transparent, itemized proposal detailing scope, milestones, and deliverables within 24 to 48 hours.',
  },
  {
    question: 'How do we schedule meetings and project reviews?',
    answer: 'We conduct highly efficient, interactive sessions via Google Meet or Zoom to review prototypes and discuss strategy, paired with dedicated, continuous WhatsApp support throughout your project lifecycle.',
  },
  {
    question: 'Is the initial consultation free of charge?',
    answer: 'Yes, our initial 20-30 minute consultation is 100% free with zero obligation, allowing us to evaluate your current digital posture and propose the ideal roadmap.',
  },
];

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact ${business.name} | Web Design & SEO in Kuwait`,
  description: 'Connect with webinOO in Kuwait City to discuss bespoke web design, Local SEO, and AI search optimization.',
  mainEntity: {
    '@type': 'LocalBusiness',
    name: business.name,
    telephone: business.phone,
    ...(business.email ? { email: business.email } : {}),
    address: {
      '@type': 'PostalAddress',
      streetAddress: business.address.streetAddress,
      addressLocality: business.address.locality,
      addressCountry: business.address.countryCode,
    },
  },
};
---

<BaseLayout
  title={`Contact Us | Web Design & SEO Consultation in Kuwait | ${business.name}`}
  description="Connect with webinOO's team in Kuwait City. Fast WhatsApp messaging, transparent proposals within 24 hours, and in-person consultations."
  lang="en"
  schema={contactSchema}
>
  <Header slot="header" lang="en" />

  <main id="main-content" class="contact-page">
    <div class="container breadcrumbs-wrap">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <!-- Hero Section -->
    <section class="container contact-hero">
      <div class="hero-badge">Ready For Your Next Project</div>
      <h1 class="page-title">Let's talk about your project and build it the right way.</h1>
      <p class="hero-desc">
        Whether you are planning a new corporate website, redesigning an existing presence to rank on Google in Kuwait, or seeking guidance on AI search visibility, we are here to help.
      </p>
    </section>

    <!-- Main Grid: Info + Form -->
    <section class="container contact-grid-section">
      <div class="contact-grid">
        <!-- Info Column -->
        <div class="contact-info-col">
          <div class="direct-chat-card">
            <div class="chat-icon-wrap">
              <MessageSquare size={28} />
            </div>
            <div class="chat-text">
              <h3>Prefer Instant Communication?</h3>
              <p>Chat directly with our team on WhatsApp for immediate feedback and advice.</p>
            </div>
            <a
              href={getWhatsAppUrl('Hello, I would like to schedule a consultation regarding a website project in Kuwait.')}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-whatsapp-direct"
            >
              Direct Chat on WhatsApp
            </a>
          </div>

          <div class="info-items-list">
            <div class="info-item">
              <div class="item-icon"><Phone size={20} /></div>
              <div class="item-content">
                <span class="item-label">WhatsApp & Direct Phone</span>
                <a href={`https://wa.me/${business.whatsappNumber}`} target="_blank" rel="noopener noreferrer" class="item-val" dir="ltr">{business.phone}</a>
              </div>
            </div>

            {business.email && (
              <div class="info-item">
                <div class="item-icon"><Mail size={20} /></div>
                <div class="item-content">
                  <span class="item-label">Direct Email</span>
                  <a href={`mailto:${business.email}`} class="item-val">{business.email}</a>
                </div>
              </div>
            )}

            <div class="info-item">
              <div class="item-icon"><MapPin size={20} /></div>
              <div class="item-content">
                <span class="item-label">Service Coverage</span>
                <span class="item-val">Serving businesses across all Kuwait governorates (Remote & Online Consultations with instant WhatsApp response)</span>
              </div>
            </div>

            <div class="info-item">
              <div class="item-icon"><Clock size={20} /></div>
              <div class="item-content">
                <span class="item-label">Working Hours</span>
                <span class="item-val">{business.workingHours.en}</span>
              </div>
            </div>
          </div>

          <div class="privacy-promise">
            <ShieldCheck size={20} class="promise-icon" />
            <p>Your privacy and project confidentiality are guaranteed. We never share your data.</p>
          </div>
        </div>

        <!-- Form Column -->
        <div class="contact-form-col">
          <div class="form-container">
            <h2 class="form-heading">Send Us Your Project Details</h2>
            <p class="form-sub">Fill out the brief form below and our consultant will respond within 24 hours.</p>

            <form
              action="https://formspree.io/f/placeholder"
              method="POST"
              class="webinoo-contact-form"
            >
              <input type="text" name="_gotcha" style="display:none !important;" tabindex="-1" autocomplete="off" />

              <div class="form-group">
                <label for="name">Your Name / Business Name <span class="required">*</span></label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="e.g. Yousef Al-Mutairi - Dar Design"
                  class="form-input"
                />
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="phone">Phone / WhatsApp (Kuwait) <span class="required">*</span></label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    required
                    placeholder="+965 xxxxxxxx"
                    class="form-input"
                  />
                </div>

                <div class="form-group">
                  <label for="email">Email Address <span class="required">*</span></label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="name@company.com"
                    class="form-input"
                  />
                </div>
              </div>

              <div class="form-group">
                <label for="service-type">Required Service</label>
                <select id="service-type" name="service" class="form-select">
                  <option value="web-design">New Corporate Website Design</option>
                  <option value="redesign-seo">Website Redesign & SEO Optimization</option>
                  <option value="ecommerce">E-Commerce Store with Knet & Apple Pay</option>
                  <option value="local-seo">Local SEO & Google Business Profile Ranking</option>
                  <option value="geo-ai">Generative Engine Optimization (GEO for AI)</option>
                  <option value="maintenance">Hosting, Security & Ongoing Support</option>
                  <option value="consultation">General Digital Consultation</option>
                </select>
              </div>

              <div class="form-group">
                <label for="budget">Estimated Budget Range</label>
                <select id="budget" name="budget" class="form-select">
                  <option value="under-500">Under 500 KD (Starter Package)</option>
                  <option value="500-1200" selected>500 - 1,200 KD (Business & SEO Package)</option>
                  <option value="1200-2500">1,200 - 2,500 KD (E-Commerce & Portals)</option>
                  <option value="above-2500">Above 2,500 KD (Custom Enterprise Software)</option>
                  <option value="not-sure">Not sure, seeking technical recommendation</option>
                </select>
              </div>

              <div class="form-group">
                <label for="message">Project Overview & Goals <span class="required">*</span></label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  required
                  placeholder="Tell us briefly about your business, target audience, and primary website goals..."
                  class="form-textarea"
                ></textarea>
              </div>

              <button type="submit" class="btn-submit">
                <span>Submit Project Details</span>
                <Send size={18} />
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- Location & Coverage Section -->
    <section class="container location-section">
      <div class="location-box">
        <div class="location-header">
          <h2>Serving All Kuwait Governorates</h2>
          <p>We partner with corporate and commercial clients across Capital, Hawally, Salmiya, Farwaniya, Jahra, and Ahmadi.</p>
        </div>
        <div class="map-placeholder">
          <div class="map-card-inner">
            <MessageSquare size={36} class="map-pin-icon" />
            <h3>Direct Communication & Fast Remote Consultations</h3>
            <p>We provide interactive strategy sessions via Google Meet & Zoom with instant WhatsApp support throughout your project.</p>
            <a
              href={getWhatsAppUrl('Hello, I would like to schedule a consultation regarding a website project in Kuwait.')}
              target="_blank"
              rel="noopener noreferrer"
              class="map-link-btn"
            >
              Direct Chat on WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="container faq-wrap">
      <FAQ
        eyebrow="Clear Process"
        title="Frequently Asked Inquiries"
        description="Direct answers on consultation steps, timelines, and proposal delivery."
        items={contactFaqs}
      />
    </section>
  </main>

  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  .contact-page {
    padding-bottom: 96px;
  }

  .breadcrumbs-wrap {
    padding-top: 24px;
  }

  .contact-hero {
    padding-top: 32px;
    padding-bottom: 48px;
    max-width: 820px;
  }

  .hero-badge {
    display: inline-block;
    padding: 4px 12px;
    background: rgba(16, 185, 129, 0.1);
    color: var(--color-accent, #10b981);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .page-title {
    font-size: clamp(32px, 4vw, 50px);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.04em;
    margin-bottom: 16px;
  }

  .hero-desc {
    font-size: 17px;
    line-height: 1.85;
    color: var(--color-ink-muted, #716b7a);
  }

  .contact-grid-section {
    margin-bottom: 80px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
  }

  @media (min-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr 1.3fr;
      gap: 48px;
    }
  }

  .direct-chat-card {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(101, 24, 172, 0.06) 100%);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: var(--radius-lg, 16px);
    padding: 28px;
    margin-bottom: 24px;
  }

  .chat-icon-wrap {
    color: var(--color-accent, #10b981);
    margin-bottom: 12px;
  }

  .chat-text h3 {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .chat-text p {
    font-size: 14px;
    color: var(--color-ink-muted, #716b7a);
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .btn-whatsapp-direct {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 14px 20px;
    background: var(--color-accent, #10b981);
    color: #ffffff;
    font-weight: 700;
    font-size: 14px;
    border-radius: var(--radius-md, 10px);
    text-decoration: none;
    transition: all 0.2s;
    box-sizing: border-box;
  }

  .btn-whatsapp-direct:hover {
    background: #059669;
    transform: translateY(-2px);
  }

  .info-items-list {
    background: var(--color-bg-card, #fffefa);
    border: 1px solid var(--color-border-default, #ddd5e1);
    border-radius: var(--radius-lg, 16px);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 24px;
  }

  .info-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .item-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(101, 24, 172, 0.08);
    color: var(--color-primary, #6518ac);
    border-radius: 10px;
    flex-shrink: 0;
  }

  .item-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .item-label {
    font-size: 12px;
    color: var(--color-ink-muted, #716b7a);
  }

  .item-val {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink-primary, #292239);
    text-decoration: none;
    line-height: 1.5;
  }

  a.item-val:hover {
    color: var(--color-primary, #6518ac);
  }

  .privacy-promise {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    background: rgba(0, 0, 0, 0.02);
    border: 1px dashed var(--color-border-default, #ddd5e1);
    border-radius: var(--radius-md, 10px);
    font-size: 12px;
    color: var(--color-ink-muted, #716b7a);
    line-height: 1.6;
  }

  .promise-icon {
    color: var(--color-accent, #10b981);
    flex-shrink: 0;
  }

  .form-container {
    background: var(--color-bg-card, #fffefa);
    border: 1px solid var(--color-border-default, #ddd5e1);
    border-radius: var(--radius-lg, 16px);
    padding: 36px 32px;
  }

  .form-heading {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .form-sub {
    font-size: 14px;
    color: var(--color-ink-muted, #716b7a);
    margin-bottom: 24px;
  }

  .webinoo-contact-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 600px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-ink-primary, #292239);
  }

  .required {
    color: #ef4444;
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    background: #ffffff;
    border: 1px solid var(--color-border-default, #ddd5e1);
    border-radius: var(--radius-md, 8px);
    padding: 12px 14px;
    color: var(--color-ink-primary, #292239);
    font-family: inherit;
    font-size: 14px;
    box-sizing: border-box;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--color-primary, #6518ac);
    box-shadow: 0 0 0 3px rgba(101, 24, 172, 0.12);
  }

  .btn-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 16px;
    background: var(--color-primary, #6518ac);
    color: #ffffff;
    font-weight: 700;
    font-size: 15px;
    border: none;
    border-radius: var(--radius-md, 8px);
    cursor: pointer;
    transition: all 0.2s;
    margin-top: 8px;
  }

  .btn-submit:hover {
    background: #50128a;
    transform: translateY(-2px);
  }

  .location-section {
    margin-bottom: 80px;
  }

  .location-box {
    background: var(--color-bg-card, #fffefa);
    border: 1px solid var(--color-border-default, #ddd5e1);
    border-radius: var(--radius-lg, 16px);
    padding: 36px 32px;
  }

  .location-header {
    margin-bottom: 24px;
  }

  .location-header h2 {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .location-header p {
    font-size: 14px;
    color: var(--color-ink-muted, #716b7a);
  }

  .map-placeholder {
    background: linear-gradient(135deg, rgba(101, 24, 172, 0.05) 0%, rgba(16, 185, 129, 0.05) 100%);
    border: 1px dashed var(--color-border-default, #ddd5e1);
    border-radius: var(--radius-md, 12px);
    padding: 48px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .map-card-inner {
    max-width: 440px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .map-pin-icon {
    color: var(--color-primary, #6518ac);
  }

  .map-card-inner h3 {
    font-size: 18px;
    font-weight: 700;
    margin: 0;
  }

  .map-card-inner p {
    font-size: 14px;
    color: var(--color-ink-muted, #716b7a);
    margin: 0;
  }

  .map-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: var(--color-primary, #6518ac);
    color: #ffffff;
    border-radius: var(--radius-md, 8px);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s;
    margin-top: 6px;
  }

  .map-link-btn:hover {
    background: #50128a;
  }

  .faq-wrap {
    margin-top: 48px;
  }
</style>
