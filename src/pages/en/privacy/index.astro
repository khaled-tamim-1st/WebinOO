---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import { business } from '@/data/business';
import { ShieldCheck, Lock } from '@lucide/astro';

const breadcrumbs = [
  { label: 'Home', href: '/en/' },
  { label: 'Privacy Policy' },
];

const lastUpdated = 'October 8, 2026';
---

<BaseLayout
  title={`Privacy Policy | ${business.name} Kuwait`}
  description="Client data protection and privacy policy of webinOO in the State of Kuwait. We adhere to the highest standards of confidentiality and digital security."
  lang="en"
>
  <Header slot="header" lang="en" />

  <main id="main-content" class="legal-page">
    <div class="container breadcrumbs-wrap">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <section class="container legal-hero">
      <div class="hero-badge">Data Protection & Confidentiality</div>
      <h1 class="legal-title">Privacy Policy & Client Data Protection</h1>
      <p class="legal-date">Last Updated: {lastUpdated}</p>
    </section>

    <section class="container legal-content-section">
      <div class="legal-body">
        <div class="legal-card-intro">
          <ShieldCheck size={28} class="intro-icon" />
          <p>
            At <strong>{business.name}</strong>, we consider the privacy and data confidentiality of our clients and partners in the State of Kuwait an utmost professional priority. This document outlines the categories of data we collect, how it is utilized, and your complete rights regarding your business records.
          </p>
        </div>

        <article class="legal-section">
          <h2>1. Data We Collect</h2>
          <p>We only collect essential information voluntarily provided when you reach out to us for services or consultations, including:</p>
          <ul>
            <li><strong>Contact Details:</strong> Your name, phone number, WhatsApp contact, and email address.</li>
            <li><strong>Business Information:</strong> Corporate name, geographic operational scope in Kuwait, and project objectives.</li>
            <li><strong>Technical Analytics:</strong> Anonymous, aggregated browsing analytics (browser type, device viewport, page performance) utilized strictly to maintain site speed and security.</li>
          </ul>
        </article>

        <article class="legal-section">
          <h2>2. Purpose of Data Utilization</h2>
          <p>Your information is used exclusively for:</p>
          <ul>
            <li>Communicating regarding project discovery, formal proposals, and technical advisories.</li>
            <li>Executing bespoke web development and search optimization agreements.</li>
            <li>Delivering ongoing technical maintenance, SSL monitoring, and server hosting.</li>
            <li>Maintaining the highest performance standards across our web properties.</li>
          </ul>
        </article>

        <article class="legal-section">
          <h2>3. Non-Disclosure & Commercial Confidentiality (NDA)</h2>
          <div class="highlight-callout">
            <Lock size={20} class="callout-icon" />
            <p>
              <strong>Strict Commitment:</strong> All business strategies, operational models, and project data shared with us remain under strict confidentiality. We never sell, rent, or trade your data with any third-party commercial entity under any circumstance.
            </p>
          </div>
        </article>

        <article class="legal-section">
          <h2>4. Data Hosting & Infrastructure Security</h2>
          <p>
            We implement industry-standard physical and electronic safeguards to protect client records against unauthorized access, loss, or alteration. All communication channels are protected with modern TLS/SSL encryption protocols and hosted on high-availability cloud infrastructure.
          </p>
        </article>

        <article class="legal-section">
          <h2>5. Cookies & Tracking</h2>
          <p>
            Our website uses strictly functional, lightweight cookies to preserve language preferences (Arabic/English) and ensure rapid page caching. We do not deploy invasive third-party cross-site behavioral tracking scripts.
          </p>
        </article>

        <article class="legal-section">
          <h2>6. Your Rights as a Client</h2>
          <p>You have the full right at any time to:</p>
          <ul>
            <li>Request a copy of the personal or corporate information maintained on file.</li>
            <li>Request corrections or updates to any inaccurate records.</li>
            <li>Request the complete deletion of inquiry records upon concluding contractual services.</li>
          </ul>
        </article>

        <article class="legal-section">
          <h2>7. Contact Information</h2>
          <p>
            For any inquiries or requests concerning this privacy policy, please contact us directly via WhatsApp at
            <a href={`https://wa.me/${business.whatsappNumber}`} class="legal-link" dir="ltr" target="_blank" rel="noopener noreferrer">{business.phone}</a>
            {business.email && <> or via email at <a href={`mailto:${business.email}`} class="legal-link">{business.email}</a></>}.
          </p>
        </article>
      </div>
    </section>
  </main>

  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  .legal-page {
    padding-bottom: 96px;
  }

  .breadcrumbs-wrap {
    padding-top: 24px;
  }

  .legal-hero {
    padding-top: 32px;
    padding-bottom: 40px;
    max-width: 820px;
  }

  .hero-badge {
    display: inline-block;
    padding: 4px 12px;
    background: rgba(16, 185, 129, 0.1);
    color: var(--color-accent, #10b981);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .legal-title {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 800;
    letter-spacing: -0.04em;
    margin-bottom: 8px;
  }

  .legal-date {
    font-size: 14px;
    color: var(--color-ink-muted, #716b7a);
  }

  .legal-content-section {
    max-width: 840px;
  }

  .legal-body {
    background: var(--color-bg-card, #fffefa);
    border: 1px solid var(--color-border-default, #ddd5e1);
    border-radius: var(--radius-lg, 16px);
    padding: 40px 36px;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  @media (max-width: 600px) {
    .legal-body {
      padding: 24px 20px;
    }
  }

  .legal-card-intro {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 20px 24px;
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: var(--radius-md, 12px);
  }

  .intro-icon {
    color: var(--color-accent, #10b981);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .legal-card-intro p {
    font-size: 15px;
    line-height: 1.8;
    color: var(--color-ink-primary, #292239);
    margin: 0;
  }

  .legal-section h2 {
    font-size: 19px;
    font-weight: 700;
    margin-bottom: 14px;
    border-left: 3px solid var(--color-primary, #6518ac);
    padding-left: 12px;
  }

  .legal-section p {
    font-size: 15px;
    color: var(--color-ink-muted, #716b7a);
    line-height: 1.8;
    margin-bottom: 14px;
  }

  .legal-section ul {
    padding-left: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--color-ink-muted, #716b7a);
    line-height: 1.7;
    font-size: 14px;
  }

  .highlight-callout {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px 20px;
    background: rgba(0, 0, 0, 0.02);
    border: 1px dashed var(--color-border-default, #ddd5e1);
    border-radius: var(--radius-md, 8px);
  }

  .callout-icon {
    color: var(--color-accent, #10b981);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .highlight-callout p {
    margin: 0;
    font-size: 14px;
  }

  .legal-link {
    color: var(--color-primary, #6518ac);
    text-decoration: underline;
    font-weight: 600;
  }

  .legal-link:hover {
    color: #50128a;
  }
</style>
