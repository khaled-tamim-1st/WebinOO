---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import CTA from '@/components/common/CTA.astro';
import { MapPin, ArrowRight, ArrowUpRight } from '@lucide/astro';

const breadcrumbs = [
  { label: 'Home', href: '/en/' },
  { label: 'Areas Served in Kuwait' },
];

const englishAreas = [
  {
    id: 'kuwait-city',
    name: 'Kuwait City (Capital)',
    gov: 'Capital Governorate',
    profile: 'Financial and executive epicenter hosting headquarters of banks, investment funds, law practices, medical centers, and business towers in Sharq, Qibla, and Al Hamra Tower.',
    businesses: ['Corporate Law & Arbitration Practices', 'Investment & Financial Firms', 'Executive Medical & Surgical Centers'],
  },
  {
    id: 'hawally',
    name: 'Hawally',
    gov: 'Hawally Governorate',
    profile: 'High-density tech and commercial trading hub; renowned for IT and hardware centers (Ibn Khaldoun St), specialized medical clinics (Beirut and Tunis St), and contracting firms.',
    businesses: ['IT & Electronics Centers (Ibn Khaldoun St)', 'Specialized Dental & Radiology Clinics', 'Contracting & MEP Engineering Firms'],
  },
  {
    id: 'salmiya',
    name: 'Salmiya',
    gov: 'Hawally Governorate',
    profile: 'Premier retail, hospitality, and coastal dining district; bustling with cafes, luxury spas, aesthetic dermatology centers, and lifestyle boutiques along Salem Al Mubarak St.',
    businesses: ['Restaurants, Specialty Cafes & F&B Concepts', 'Aesthetic & Dermatology Centers', 'Fashion Boutiques & Lifestyle Retail'],
  },
  {
    id: 'farwaniya',
    name: 'Farwaniya, Shuwaikh & Al-Rai',
    gov: 'Farwaniya Governorate',
    profile: 'Industrial, wholesale, and logistics powerhouse adjacent to Shuwaikh and Al-Dajeej; hub of luxury furniture showrooms, building material suppliers, and freight warehouses.',
    businesses: ['Furniture Showrooms & Interior Joinery', 'Civil Contracting & Renovation Works', 'Logistics, Warehousing & Customs Clearance'],
  },
  {
    id: 'jahra',
    name: 'Jahra & Al-Mutlaa',
    gov: 'Jahra Governorate',
    profile: 'Kuwait’s largest geographical governorate experiencing unprecedented residential development in Al-Mutlaa; high demand for turnkey contracting, villas interior design, and clinics.',
    businesses: ['Turnkey Villa Construction & Finishing', 'Interior Architecture & Decor Studios', 'Family Healthcare & Diagnostic Clinics'],
  },
  {
    id: 'ahmadi',
    name: 'Ahmadi & Fahaheel',
    gov: 'Ahmadi Governorate',
    profile: 'Energy industry capital (KOC support enterprises) paired with the thriving retail and maritime commercial markets of Fahaheel and southern residential developments.',
    businesses: ['Oil & Gas Engineering Contractors', 'Commercial Retail in Fahaheel & Al Kout', 'Heavy Machinery & Southern Logistics'],
  },
];
---

<BaseLayout
  title="Areas We Serve Across Kuwait | Local SEO & Web Design | webinOO"
  description="webinOO provides specialized web design and Local SEO across all Kuwait governorates: Kuwait City, Hawally, Salmiya, Farwaniya, Jahra, and Ahmadi."
  lang="en"
>
  <Header slot="header" lang="en" />

  <main class="areas-hub-page">
    <div class="container breadcrumbs-wrap">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <!-- Hero Section -->
    <section class="container areas-hero">
      <div class="hero-badge">Comprehensive Kuwait Coverage</div>
      <h1 class="page-title">Local Web Design and SEO tailored to the unique business fabric of your area.</h1>
      <p class="hero-desc">
        Consumer intent and search behavior in the Capital differ significantly from Hawally, Salmiya, or Jahra. At webinOO, we engineer your digital presence to dominate the exact geographic queries most lucrative to your business.
      </p>
    </section>

    <!-- Areas Grid -->
    <section class="container areas-grid-section">
      <div class="areas-grid">
        {
          englishAreas.map((area) => (
            <article class="area-card">
              <div class="card-top">
                <span class="gov-badge">{area.gov}</span>
                <a href={`/en/areas/${area.id}/`} class="card-arrow" aria-label={`View ${area.name}`}>
                  <ArrowUpRight size={18} />
                </a>
              </div>

              <div class="area-title-wrap">
                <MapPin size={22} class="pin-icon" />
                <h2>
                  <a href={`/en/areas/${area.id}/`}>{area.name}</a>
                </h2>
              </div>

              <p class="area-desc">{area.profile}</p>

              <div class="prominent-section">
                <span class="prominent-label">Prominent Sectors:</span>
                <ul class="prominent-list">
                  {area.businesses.map((biz) => (
                    <li>{biz}</li>
                  ))}
                </ul>
              </div>

              <div class="card-footer">
                <a href={`/en/areas/${area.id}/`} class="more-link">
                  Explore local strategy <ArrowRight size={15} />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Local Strategy Box -->
    <section class="container local-strategy-section">
      <div class="strategy-box">
        <div class="strategy-content">
          <span class="strategy-badge">Why Local SEO Matters in Kuwait</span>
          <h2>Over 72% of commercial searches in Kuwait result in a direct call or visit within 24 hours</h2>
          <p>
            Whether your prospective client is searching for an executive law firm in Sharq, a pediatric dental clinic in Salmiya, or a contractor in Al-Mutlaa, claiming a position in the top 3 Google Local Map results is the single highest-ROI customer acquisition channel in Kuwait.
          </p>
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="container cta-wrap">
      <CTA
        eyebrow="Dominate Your Local Area"
        title="Ready to rank #1 in your district across Kuwait?"
        description="Let's optimize your website and Google Business Profile to capture nearby customers before your competitors."
        ctaText="Book a Free Local SEO Consultation"
        whatsappMessage="Hello, I would like to consult on ranking my business in my local area in Kuwait."
      />
    </section>
  </main>

  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  .areas-hub-page {
    padding-bottom: 96px;
  }

  .breadcrumbs-wrap {
    padding-top: 24px;
  }

  .areas-hero {
    padding-top: 32px;
    padding-bottom: 48px;
    max-width: 860px;
  }

  .hero-badge {
    display: inline-block;
    padding: 4px 12px;
    background: rgba(16, 185, 129, 0.1);
    color: var(--color-accent, #10b981);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .page-title {
    font-size: clamp(32px, 4vw, 50px);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.04em;
    margin-bottom: 16px;
  }

  .hero-desc {
    font-size: 17px;
    line-height: 1.85;
    color: var(--color-ink-muted, #716b7a);
  }

  .areas-grid-section {
    margin-bottom: 80px;
  }

  .areas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 32px;
  }

  .area-card {
    background: var(--color-bg-card, #fffefa);
    border: 1px solid var(--color-border-default, #ddd5e1);
    border-radius: var(--radius-lg, 16px);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.25s, box-shadow 0.25s;
  }

  .area-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.06);
    border-color: var(--color-primary, #6518ac);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .gov-badge {
    font-size: 11px;
    font-weight: 700;
    color: var(--color-accent, #10b981);
    background: rgba(16, 185, 129, 0.1);
    padding: 2px 10px;
    border-radius: 999px;
  }

  .card-arrow {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-bg-alt, #f7f3f9);
    display: grid;
    place-items: center;
    color: var(--color-ink-primary, #292239);
    text-decoration: none;
    transition: all 0.2s;
  }

  .area-card:hover .card-arrow {
    background: var(--color-primary, #6518ac);
    color: #ffffff;
  }

  .area-title-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .pin-icon {
    color: var(--color-primary, #6518ac);
    flex-shrink: 0;
  }

  .area-title-wrap h2 {
    font-size: 20px;
    margin: 0;
    line-height: 1.4;
  }

  .area-title-wrap h2 a {
    color: var(--color-ink-primary, #292239);
    text-decoration: none;
    transition: color 0.2s;
  }

  .area-title-wrap h2 a:hover {
    color: var(--color-primary, #6518ac);
  }

  .area-desc {
    font-size: 14px;
    color: var(--color-ink-muted, #716b7a);
    line-height: 1.75;
    margin: 0 0 20px;
    flex-grow: 1;
  }

  .prominent-section {
    background: rgba(0, 0, 0, 0.02);
    border: 1px dashed var(--color-border-subtle, #eae3ef);
    border-radius: 8px;
    padding: 16px;
    margin-bottom: 20px;
  }

  .prominent-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    color: var(--color-ink-muted, #716b7a);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }

  .prominent-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 12px;
    color: var(--color-ink-primary, #292239);
  }

  .prominent-list li::before {
    content: "•";
    color: var(--color-accent, #10b981);
    margin-right: 6px;
  }

  .card-footer {
    padding-top: 16px;
    border-top: 1px solid var(--color-border-default, #ddd5e1);
  }

  .more-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-primary, #6518ac);
    text-decoration: none;
    transition: gap 0.2s;
  }

  .more-link:hover {
    gap: 12px;
  }

  .local-strategy-section {
    margin-bottom: 80px;
  }

  .strategy-box {
    background: linear-gradient(135deg, #ffffff 0%, var(--color-primary-subtle, #f4eafa) 100%);
    border: 1px solid var(--color-primary-light, #eee5f5);
    border-radius: var(--radius-xl, 20px);
    padding: 48px 32px;
    box-shadow: 0 4px 20px -2px rgba(101, 24, 172, 0.05);
  }

  .strategy-content {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .strategy-badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-primary, #6518ac);
    background: var(--color-primary-light, #eee5f5);
    border: 1px solid rgba(101, 24, 172, 0.18);
    padding: 4px 14px;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
  }

  .strategy-content h2 {
    font-size: clamp(24px, 3.2vw, 36px);
    font-weight: 800;
    line-height: 1.35;
    color: var(--color-ink-primary, #292239);
    margin-bottom: 16px;
  }

  .strategy-content p {
    font-size: 16px;
    color: var(--color-ink-secondary, #433954);
    line-height: 1.8;
    margin: 0;
  }

  .cta-wrap {
    margin-top: 48px;
  }
</style>
