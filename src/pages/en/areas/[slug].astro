---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import FAQ from '@/components/common/FAQ.astro';
import CTA from '@/components/common/CTA.astro';
import { enAreas, type EnArea } from '@/data/en/areas';
import { business } from '@/data/business';
import { Lightbulb, Building, CircleCheck } from '@lucide/astro';

export function getStaticPaths() {
  return enAreas.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

export interface Props {
  area: EnArea;
}

const { area } = Astro.props;

const siteBase = Astro.site ? Astro.site.origin : 'https://webinoo.online';

const breadcrumbs = [
  { label: 'Home', href: '/en/' },
  { label: 'Areas Served', href: '/en/areas/' },
  { label: area.areaNameEn },
];

const areaSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: `${business.name} - ${area.areaNameEn}`,
  description: area.description,
  url: `${siteBase}/en/areas/${area.slug}/`,
  areaServed: {
    '@type': 'AdministrativeArea',
    name: area.areaNameEn,
    containedInPlace: {
      '@type': 'AdministrativeArea',
      name: area.governorate,
    },
  },
  provider: {
    '@type': 'LocalBusiness',
    name: business.name,
    telephone: business.phone,
    address: {
      '@type': 'PostalAddress',
      addressLocality: business.address.locality,
      addressCountry: business.address.countryCode,
    },
  },
};
---

<BaseLayout
  title={area.title}
  description={area.description}
  schema={areaSchema}
  lang="en"
>
  <Header lang="en" />

  <main id="main-content" class="area-detail-page">
    <div class="container breadcrumbs-wrap">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <!-- Hero Header -->
    <header class="container area-hero">
      <div class="hero-top-badges">
        <span class="gov-badge">{area.governorate}</span>
        <span class="ar-badge" dir="rtl">{area.areaNameAr}</span>
      </div>
      <h1 class="area-h1">{area.h1}</h1>
      <p class="area-commercial-lead">{area.commercialProfile}</p>
    </header>

    <!-- Local Search Strategy Callout -->
    <section class="container strategy-callout-section">
      <div class="strategy-card">
        <div class="strategy-icon-box">
          <Lightbulb size={26} class="strategy-icon" />
        </div>
        <div class="strategy-text">
          <h2>Key to Ranking on Google & Local Search in {area.areaNameEn}:</h2>
          <p>{area.localSearchTip}</p>
        </div>
      </div>
    </section>

    <!-- Prominent Businesses Grid -->
    <section class="container prominent-grid-section">
      <div class="prominent-box">
        <h2 class="section-title">
          <Building size={22} class="inline-icon" />
          High-Demand & Competitive Sectors in {area.areaNameEn}
        </h2>
        <div class="businesses-tags">
          {
            area.prominentBusinesses.map((biz) => (
              <div class="business-tag">
                <CircleCheck size={16} class="check-icon" />
                <span>{biz}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Editorial Content Section -->
    <section class="container editorial-section">
      <div class="editorial-card markdown-content" set:html={area.contentHtml} />
    </section>

    <!-- Area Specific FAQs -->
    {
      area.faqs && area.faqs.length > 0 && (
        <section class="container faq-section">
          <FAQ
            eyebrow="Local Search FAQ"
            title={`Frequently Asked Questions in ${area.areaNameEn}`}
            description={`Clear answers to help your business in ${area.areaNameEn} make informed digital decisions.`}
            faqs={area.faqs}
          />
        </section>
      )
    }

    <!-- Bottom CTA -->
    <section class="container cta-wrap">
      <CTA
        eyebrow="Local Digital Authority"
        title={"Running a Business in " + area.areaNameEn + "?"}
        description={`Let's build a fast, high-ranking website that converts searches in ${area.areaNameEn} into active customer inquiries.`}
        buttonText={"Chat with us about " + area.areaNameEn}
        whatsappMessage={`Hello, I would like to consult with webinOO regarding a website and Local SEO for my business in ${area.areaNameEn}.`}
      />
    </section>
  </main>

  <Footer lang="en" />
</BaseLayout>

<style>
  .area-detail-page {
    padding-bottom: var(--space-20);
  }

  .breadcrumbs-wrap {
    padding-top: var(--space-6);
  }

  .area-hero {
    padding-top: var(--space-8);
    padding-bottom: var(--space-10);
    max-width: 860px;
  }

  .hero-top-badges {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .gov-badge {
    padding: var(--space-1) var(--space-3);
    background: var(--color-primary-light, #eee5f5);
    color: var(--color-primary, #6518ac);
    border: 1px solid rgba(101, 24, 172, 0.18);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: 700;
  }

  .ar-badge {
    padding: var(--space-1) var(--space-3);
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: 500;
  }

  .area-h1 {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 800;
    line-height: 1.25;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .area-commercial-lead {
    font-size: var(--font-size-lg);
    line-height: 1.8;
    color: var(--color-text-secondary);
  }

  .strategy-callout-section {
    margin-bottom: var(--space-10);
  }

  .strategy-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
    background: linear-gradient(135deg, #ffffff 0%, var(--color-primary-subtle, #f4eafa) 100%);
    border: 1px solid var(--color-primary-light, #eee5f5);
    border-left: 4px solid var(--color-primary, #6518ac);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: 0 4px 20px -2px rgba(101, 24, 172, 0.05);
  }

  @media (max-width: 640px) {
    .strategy-card {
      flex-direction: column;
      padding: var(--space-6);
    }
  }

  .strategy-icon-box {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary, #6518ac);
    color: #ffffff;
    border-radius: var(--radius-lg);
    flex-shrink: 0;
    box-shadow: 0 4px 14px rgba(101, 24, 172, 0.22);
  }

  .strategy-text h2 {
    font-size: var(--font-size-lg);
    font-weight: 800;
    color: var(--color-ink-primary, #292239);
    margin-bottom: var(--space-2);
    line-height: 1.4;
  }

  .strategy-text p {
    font-size: var(--font-size-base);
    color: var(--color-ink-secondary, #433954);
    line-height: 1.85;
    margin: 0;
  }

  .prominent-grid-section {
    margin-bottom: var(--space-12);
  }

  .prominent-box {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
  }

  .inline-icon {
    color: var(--color-accent);
  }

  .businesses-tags {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .businesses-tags {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .businesses-tags {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .business-tag {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    color: var(--color-text-primary);
  }

  .check-icon {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .editorial-section {
    margin-bottom: var(--space-16);
  }

  .editorial-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-10);
  }

  @media (max-width: 640px) {
    .editorial-card {
      padding: var(--space-6) var(--space-5);
    }
  }

  .markdown-content :global(h2) {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-3);
  }

  .markdown-content :global(h2:first-child) {
    margin-top: 0;
  }

  .markdown-content :global(h3) {
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .markdown-content :global(p) {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: 1.85;
    margin-bottom: var(--space-4);
  }

  .markdown-content :global(ol),
  .markdown-content :global(ul) {
    padding-left: var(--space-6);
    padding-right: 0;
    margin-bottom: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    color: var(--color-text-secondary);
    line-height: 1.75;
  }

  .markdown-content :global(li strong) {
    color: var(--color-text-primary);
  }

  .faq-section {
    margin-bottom: var(--space-16);
  }

  .cta-wrap {
    margin-top: var(--space-8);
  }
</style>
