---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import CTA from '@/components/common/CTA.astro';
import { enBlogPosts, type EnBlogPost } from '@/data/en/blog';
import { business } from '@/data/business';
import { Calendar, Clock, User, Tag } from '@lucide/astro';

export function getStaticPaths() {
  return enBlogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

export interface Props {
  post: EnBlogPost;
}

const { post } = Astro.props;

const siteBase = Astro.site ? Astro.site.origin : 'https://webinoo.online';

const breadcrumbs = [
  { label: 'Home', href: '/en/' },
  { label: 'Knowledge Base', href: '/en/blog/' },
  { label: post.h1 },
];

const pubDateObj = typeof post.pubDate === 'string' ? new Date(post.pubDate) : post.pubDate;

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
}

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.h1,
  description: post.description,
  datePublished: pubDateObj.toISOString(),
  dateModified: pubDateObj.toISOString(),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${siteBase}/en/blog/${post.slug}/`,
  },
  author: {
    '@type': 'Organization',
    name: post.author,
    url: `${siteBase}/en/`,
  },
  publisher: {
    '@type': 'Organization',
    name: business.name,
    logo: {
      '@type': 'ImageObject',
      url: `${siteBase}/webinoo-logo.png`,
    },
  },
  keywords: post.tags.join(', '),
};
---

<BaseLayout
  title={post.title}
  description={post.description}
  schema={articleSchema}
  lang="en"
>
  <Header slot="header" lang="en" />

  <main id="main-content" class="article-page">
    <div class="container breadcrumbs-wrap">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <!-- Article Header -->
    <header class="container article-hero">
      <div class="hero-meta-top">
        <span class="category-pill">{post.category}</span>
        <span class="read-estimate">
          <Clock size={15} class="meta-icon" />
          {post.readTimeMinutes} min read
        </span>
      </div>

      <h1 class="article-h1">{post.h1}</h1>

      <div class="hero-meta-bottom">
        <div class="author-info">
          <div class="author-avatar">
            <User size={18} />
          </div>
          <span class="author-name">{post.author}</span>
        </div>
        <span class="meta-divider">•</span>
        <div class="date-info">
          <Calendar size={15} class="meta-icon" />
          <time datetime={pubDateObj.toISOString()}>{formatDate(pubDateObj)}</time>
        </div>
      </div>
    </header>

    <!-- Article Body -->
    <article class="container article-container">
      <div class="article-card-main">
        <div class="markdown-content" set:html={post.contentHtml} />

        <!-- Tags Row -->
        <div class="article-tags-wrap">
          <span class="tags-title">
            <Tag size={16} class="tag-icon" />
            Tags:
          </span>
          <div class="tags-list">
            {post.tags.map((t) => (
              <span class="tag-badge">{t}</span>
            ))}
          </div>
        </div>

        <!-- Author Bio Box -->
        <div class="author-bio-card">
          <div class="bio-avatar">
            <User size={28} />
          </div>
          <div class="bio-text">
            <h3>Written by: {post.author}</h3>
            <p>
              The webinOO engineering and search intelligence team in Kuwait. We architect high-performance websites, Local SEO, and Generative Engine Optimization (GEO) to help Kuwait-based businesses scale with digital authority.
            </p>
          </div>
        </div>
      </div>
    </article>

    <!-- Bottom CTA -->
    <section class="container cta-wrap">
      <CTA
        eyebrow="Kuwait Digital Consultation"
        title="Need Help Implementing This for Your Business?"
        description="webinOO engineering team in Kuwait is ready to assist you in planning and architecting your digital presence with highest standards."
        buttonText="Consult webinOO Team"
        whatsappMessage={`Hello, I read the article "${post.h1}" on your website and would like a consultation for my business.`}
      />
    </section>
  </main>

  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  .article-page {
    padding-bottom: var(--space-20);
    direction: ltr;
    text-align: left;
  }

  .breadcrumbs-wrap {
    padding-top: var(--space-6);
  }

  .article-hero {
    padding-top: var(--space-8);
    padding-bottom: var(--space-10);
    max-width: 860px;
  }

  .hero-meta-top {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .category-pill {
    padding: var(--space-1) var(--space-3);
    background: rgba(16, 185, 129, 0.1);
    color: var(--color-accent);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: 700;
  }

  .read-estimate {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .meta-icon {
    color: var(--color-text-muted);
  }

  .article-h1 {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 800;
    line-height: 1.3;
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
    letter-spacing: -0.02em;
  }

  .hero-meta-bottom {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .author-avatar {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(16, 185, 129, 0.15);
    color: var(--color-accent);
    border-radius: var(--radius-full);
  }

  .author-name {
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .meta-divider {
    color: var(--color-text-muted);
  }

  .date-info {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-text-muted);
  }

  .article-container {
    max-width: 860px;
    margin-bottom: var(--space-16);
  }

  .article-card-main {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-10) var(--space-10);
  }

  @media (max-width: 640px) {
    .article-card-main {
      padding: var(--space-6) var(--space-5);
    }
  }

  .markdown-content :global(h2) {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-3);
  }

  .markdown-content :global(h2:first-child) {
    margin-top: 0;
  }

  .markdown-content :global(h3) {
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .markdown-content :global(p) {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: 1.85;
    margin-bottom: var(--space-5);
  }

  .markdown-content :global(blockquote) {
    margin: var(--space-6) 0;
    padding: var(--space-4) var(--space-6);
    background: rgba(16, 185, 129, 0.08);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
  }

  .markdown-content :global(blockquote p) {
    margin-bottom: 0.5rem;
    color: var(--color-text-primary);
    font-size: var(--font-size-base);
    font-style: normal;
  }

  .markdown-content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .markdown-content :global(ul),
  .markdown-content :global(ol) {
    padding-left: var(--space-6);
    margin-bottom: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    color: var(--color-text-secondary);
    line-height: 1.8;
  }

  .markdown-content :global(li strong) {
    color: var(--color-text-primary);
  }

  .markdown-content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-8) 0;
  }

  /* Responsive table styles */
  .markdown-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-6) 0 var(--space-8);
    font-size: var(--font-size-sm);
    display: block;
    overflow-x: auto;
  }

  .markdown-content :global(th) {
    background: var(--color-bg-alt);
    color: var(--color-text-primary);
    font-weight: 700;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .markdown-content :global(td) {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    text-align: left;
  }

  .markdown-content :global(tr:nth-child(even)) {
    background: rgba(255, 255, 255, 0.015);
  }

  .article-tags-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-6) 0;
    margin-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .tags-title {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .tag-icon {
    color: var(--color-accent);
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag-badge {
    padding: 3px 10px;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: 11px;
    color: var(--color-text-secondary);
  }

  .author-bio-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-6);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    margin-top: var(--space-8);
  }

  @media (max-width: 520px) {
    .author-bio-card {
      flex-direction: column;
    }
  }

  .bio-avatar {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(16, 185, 129, 0.15);
    color: var(--color-accent);
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  .bio-text h3 {
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }

  .bio-text p {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .cta-wrap {
    margin-top: var(--space-8);
  }
</style>
