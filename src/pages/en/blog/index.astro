---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import CTA from '@/components/common/CTA.astro';
import { Calendar, Clock, ArrowRight, Tag } from '@lucide/astro';
import { enBlogPosts } from '@/data/en/blog';

const breadcrumbs = [
  { label: 'Home', href: '/en/' },
  { label: 'Blog & Guides' },
];

function formatDate(date: Date | string) {
  const d = typeof date === 'string' ? new Date(date) : date;
  return new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(d);
}
---

<BaseLayout
  title="webinOO Knowledge Hub | Web Design, SEO & AI Search Guides in Kuwait"
  description="Practical guides and authority articles on website pricing, Knet payment gateways, Local SEO, and Generative Engine Optimization (GEO) in Kuwait."
  lang="en"
>
  <Header slot="header" lang="en" />

  <main class="blog-hub-page">
    <div class="container breadcrumbs-wrap">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <!-- Hero Section -->
    <section class="container blog-hero">
      <div class="hero-badge">Actionable Insights for Kuwait Business</div>
      <h1 class="page-title">Everything you need to know about Websites, SEO, and AI Search in Kuwait.</h1>
      <p class="hero-desc">
        Straightforward, research-backed guides based on actual Kuwait market dynamics, consumer behavior, and search engine algorithms. Built to help you make informed digital decisions.
      </p>
    </section>

    <!-- Articles Grid -->
    <section class="container articles-grid-section">
      <div class="articles-grid">
        {
          enBlogPosts.map((post) => (
            <article class="article-card">
              <div class="card-meta-top">
                <span class="category-badge">{post.category}</span>
                <span class="read-time">
                  <Clock size={14} class="meta-icon" />
                  {post.readTimeMinutes} min read
                </span>
              </div>

              <h2 class="card-title">
                <a href={`/en/blog/${post.slug}/`}>{post.h1}</a>
              </h2>

              <p class="card-excerpt">{post.description}</p>

              <div class="tags-row">
                {post.tags.slice(0, 2).map((t) => (
                  <span class="tag-chip">
                    <Tag size={12} class="tag-icon" />
                    {t}
                  </span>
                ))}
              </div>

              <div class="card-footer">
                <span class="pub-date">
                  <Calendar size={14} class="meta-icon" />
                  {formatDate(post.pubDate)}
                </span>
                <a href={`/en/blog/${post.slug}/`} class="read-more-link" aria-label={`Read ${post.h1}`}>
                  Read Guide <ArrowRight size={15} />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="container cta-wrap">
      <CTA
        eyebrow="Apply These Strategies"
        title="Want us to implement these search strategies on your site?"
        description="Connect with our consultants today to architect the ideal digital roadmap for your business in Kuwait."
        ctaText="Book a Free Discovery Call"
        whatsappMessage="Hello, I read your knowledge base and would like to consult on applying these strategies to my business in Kuwait."
      />
    </section>
  </main>

  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  .blog-hub-page {
    padding-bottom: 96px;
  }

  .breadcrumbs-wrap {
    padding-top: 24px;
  }

  .blog-hero {
    padding-top: 32px;
    padding-bottom: 48px;
    max-width: 860px;
  }

  .hero-badge {
    display: inline-block;
    padding: 4px 12px;
    background: rgba(16, 185, 129, 0.1);
    color: var(--color-accent, #10b981);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .page-title {
    font-size: clamp(32px, 4vw, 50px);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.04em;
    margin-bottom: 16px;
  }

  .hero-desc {
    font-size: 17px;
    line-height: 1.85;
    color: var(--color-ink-muted, #716b7a);
  }

  .articles-grid-section {
    margin-bottom: 80px;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 32px;
  }

  .article-card {
    background: var(--color-bg-card, #fffefa);
    border: 1px solid var(--color-border-default, #ddd5e1);
    border-radius: var(--radius-lg, 16px);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.25s, box-shadow 0.25s;
  }

  .article-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.06);
    border-color: var(--color-primary, #6518ac);
  }

  .card-meta-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .category-badge {
    font-size: 11px;
    font-weight: 700;
    color: var(--color-primary, #6518ac);
    background: rgba(101, 24, 172, 0.08);
    padding: 2px 10px;
    border-radius: 999px;
  }

  .read-time {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: var(--color-ink-muted, #716b7a);
  }

  .meta-icon {
    color: var(--color-ink-muted, #716b7a);
  }

  .card-title {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 12px;
  }

  .card-title a {
    color: var(--color-ink-primary, #292239);
    text-decoration: none;
    transition: color 0.2s;
  }

  .card-title a:hover {
    color: var(--color-primary, #6518ac);
  }

  .card-excerpt {
    font-size: 14px;
    color: var(--color-ink-muted, #716b7a);
    line-height: 1.75;
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    color: var(--color-ink-muted, #716b7a);
    background: var(--color-bg-alt, #f7f3f9);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .tag-icon {
    opacity: 0.7;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid var(--color-border-default, #ddd5e1);
  }

  .pub-date {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--color-ink-muted, #716b7a);
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-primary, #6518ac);
    text-decoration: none;
    transition: gap 0.2s;
  }

  .read-more-link:hover {
    gap: 10px;
  }

  .cta-wrap {
    margin-top: 48px;
  }
</style>
