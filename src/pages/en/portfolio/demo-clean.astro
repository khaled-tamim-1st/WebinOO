---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import CTA from '@/components/common/CTA.astro';
import {
  TrendingUp,
  ShieldCheck,
  ArrowUpRight,
  ExternalLink,
  Zap,
  DollarSign,
  Clock,
  Cpu
} from '@lucide/astro';

const breadcrumbs = [
  { label: 'Home', href: '/en/' },
  { label: 'Portfolio & Case Studies', href: '/en/portfolio/' },
  { label: 'Demo Clean Kuwait Case Study' },
];

const caseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    '@id': 'https://webinoo.online/en/portfolio/demo-clean/#article',
    'headline': 'Demo Clean Kuwait Case Study: Scaling Service Conversions +183% and Cutting CAC by 64%',
    'name': 'Demo Clean Kuwait Cleaning & Pest Control Platform Case Study',
    'description': 'Verified engineering case study: How webinOO re-engineered Demo Clean Kuwait (democleankw.com) with Next.js 15, cutting page load to 0.68s, doubling conversion rate (+183%), reducing CAC by 64%, and automating field dispatches in 11.5 minutes.',
    'inLanguage': 'en-US',
    'url': 'https://webinoo.online/en/portfolio/demo-clean/',
    'datePublished': '2026-10-23T09:00:00+03:00',
    'dateModified': '2026-10-23T12:00:00+03:00',
    'author': {
      '@type': 'Organization',
      'name': 'webinOO',
      'url': 'https://webinoo.online'
    },
    'publisher': {
      '@type': 'Organization',
      'name': 'webinOO',
      'url': 'https://webinoo.online'
    },
    'about': [
      { '@type': 'Thing', 'name': 'Kuwait Cleaning & Pest Control SEO Case Study' },
      { '@type': 'Thing', 'name': 'Programmatic Local SEO Architecture' },
      { '@type': 'Thing', 'name': 'Next.js 15 Edge Performance' },
      { '@type': 'Thing', 'name': 'Real-Time Field Operations Automation' }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': [
      {
        '@type': 'Question',
        'name': 'Why do Google Ads alone fail for home and commercial service companies in Kuwait?',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'Google Ads cost-per-click (PPC) in Kuwait averages between $15 and $35 in competitive service niches. When high-cost traffic lands on a sluggish 4-second WordPress website, over 70% of prospects bounce before the page renders. The sustainable solution requires sub-second edge performance paired with organic Programmatic Local SEO.'
        }
      },
      {
        '@type': 'Question',
        'name': 'How did sub-800ms load time (0.68s LCP) generate a +183% conversion lift?',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'In urgent pest control and commercial cleaning scenarios, consumers make phone call decisions within seconds from mobile devices. Eliminating page lag enabled immediate engagement, increasing overall conversion rate from 2.4% to 6.8%.'
        }
      },
      {
        '@type': 'Question',
        'name': 'What is the Programmatic Local SEO engine deployed by webinOO for Demo Clean?',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'webinOO engineered 35+ specialized landing pages covering all 6 Kuwait governorates and 22+ prime residential and commercial districts, complemented by dynamic XML image sitemaps and exhaustive Schema.org structured data.'
        }
      },
      {
        '@type': 'Question',
        'name': 'How did Telegram webhook automation compress response time from 45 min to 11.5 min?',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'By bypassing slow email forms and directly routing inspection inquiries through Telegram Bot API webhooks into field dispatch rooms, allowing technicians to initiate 1-tap phone calls or contextual WhatsApp chats within minutes.'
        }
      }
    ]
  }
];
---

<BaseLayout
  title="Demo Clean Kuwait Case Study: Scaling Service Conversions +183% and Cutting CAC by 64% | webinOO"
  description="Verified case study: How webinOO re-engineered Demo Clean Kuwait (democleankw.com) with Next.js 15, cutting page load to 0.68s, doubling conversion rate (+183%), and cutting CAC by 64%."
  lang="en"
  schema={caseSchema}
>
  <Header slot="header" lang="en" />

  <main class="clash-case-study en-version" dir="ltr">
    <!-- Hero / Header Section -->
    <header class="case-hero">
      <div class="container hero-container">
        <Breadcrumbs items={breadcrumbs} />

        <div class="hero-badges">
          <span class="badge-pill badge-primary">Verified Performance Case Study</span>
          <span class="badge-pill badge-green">0.68s Instant Load Time (LCP)</span>
          <span class="badge-pill badge-coral">Local SEO & Field Operations Automation — Kuwait</span>
        </div>

        <h1 class="hero-title">
          Demo Clean Kuwait Case Study: Scaling Service Conversions +183% and Cutting CAC by 64%
        </h1>

        <p class="hero-lead">
          <strong>webinOO</strong> completely re-engineered the digital architecture of <a href="https://democleankw.com" target="_blank" rel="dofollow" class="inline-store-link">Demo Clean Kuwait (democleankw.com)</a> from the ground up. By deploying Next.js 15 on Cloudflare Edge Workers, implementing a Programmatic Local SEO engine spanning <strong>22+ residential districts in Kuwait</strong>, and integrating real-time Telegram webhook dispatch automation; Demo Clean escaped the brutal Google Ads PPC treadmill ($15–$35 per click), doubling overall <strong>conversion rate (+183%)</strong> and slashing <strong>Customer Acquisition Cost (CAC) by 64%</strong>.
        </p>

        <!-- Live Store Preview Action Button -->
        <div class="hero-actions">
          <a
            href="https://democleankw.com"
            target="_blank"
            rel="dofollow"
            class="live-store-button"
          >
            <span>Inspect Live Platform: democleankw.com</span>
            <ArrowUpRight size={18} />
          </a>
          <span class="live-status-note">
            Verified production deployment (DoFollow link)
          </span>
        </div>

        <!-- Philosophical / Psychological Core Premise Callout -->
        <div class="philosophy-banner">
          <div class="banner-top">
            <span class="banner-tag">The Kuwait Service Market Dilemma: Paid PPC Bleed vs. Instant Edge Speed</span>
            <span class="banner-stat">Empirical Commercial Law</span>
          </div>
          <p class="banner-text">
            <strong>The Commercial Dilemma in Kuwait:</strong> Paying 5 to 11 Kuwaiti Dinars ($15–$35) for every Google Ads click only to route prospects to a sluggish 4.8-second WordPress site triggers a 70%+ bounce rate — burning liquid capital with zero ROI. In urgent home services and pest control, <strong>sub-800ms speed and real-time field dispatch automation</strong> are the decisive factors that turn clicks into closed contracts in 11.5 minutes instead of surrendering leads to faster competitors.
          </p>
        </div>

        <!-- Bento KPI Grid (Before vs After) -->
        <div class="bento-kpi-grid">
          <div class="kpi-card highlight-card">
            <div class="kpi-label">Overall Conversion Rate (CR)</div>
            <div class="kpi-value">6.8%</div>
            <div class="kpi-delta positive">
              <TrendingUp size={16} /> +183% Growth (Up from 2.4%)
            </div>
            <div class="kpi-sub">Nearly 7 out of every 100 visitors convert into direct calls or confirmed WhatsApp bookings</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-label">Largest Contentful Paint (LCP)</div>
            <div class="kpi-value">0.68s</div>
            <div class="kpi-delta positive">
              <Zap size={16} /> 85% Speed Lift (Down from 4.8s)
            </div>
            <div class="kpi-sub">Zero-latency delivery via Cloudflare Edge nodes in Kuwait and the GCC</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-label">Average Field Response Time</div>
            <div class="kpi-value">11.5 min</div>
            <div class="kpi-delta positive">
              <Clock size={16} /> 74% Delay Reduction (Down from 45 min)
            </div>
            <div class="kpi-sub">Instant Telegram notifications allow technicians to connect with leads within minutes</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-label">Customer Acquisition Cost (CAC)</div>
            <div class="kpi-value">-64% Reduction</div>
            <div class="kpi-delta positive">
              <DollarSign size={16} /> Massive Operational Margin Gain
            </div>
            <div class="kpi-sub">Driven by organic search rankings across 22+ high-value Kuwait districts</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-label">Google PageSpeed Mobile Score</div>
            <div class="kpi-value">100 / 100</div>
            <div class="kpi-delta positive">
              <Cpu size={16} /> Flawless Score (Up from 34/100)
            </div>
            <div class="kpi-sub">Absolute layout stability with CLS = 0.000 across all mobile viewports</div>
          </div>

          <div class="kpi-card conversion-card">
            <div class="kpi-label">Recurring SaaS Software Fees</div>
            <div class="kpi-value">$0.00 / month</div>
            <div class="kpi-delta positive">
              <ShieldCheck size={16} /> 100% Software Expense Savings
            </div>
            <div class="kpi-sub">Custom self-hosted CRM, CMS, and Telegram automation engine</div>
          </div>
        </div>

        <!-- Psychological Zero-Ad Affirmation Box -->
        <div class="zero-ad-alert">
          <div class="zero-ad-header">
            <ShieldCheck size={22} class="alert-icon" />
            <strong>Official Kuwait Regulatory Compliance:</strong>
          </div>
          <p>
            Demo Clean operates under strict Kuwait governmental licenses, including <strong>Ministry of Health License #14620/2025</strong> and <strong>Commercial Registration #532627</strong>. All performance metrics documented in this case study originate from verified audit tools (Google PageSpeed Insights, Chrome User Experience Report, and Ahrefs SEO Audit), validating authentic commercial outcomes delivered in the State of Kuwait.
          </p>
        </div>
      </div>
    </header>

    <!-- Main Content Layout (Article + Sticky Sidebar) -->
    <div class="container case-layout">
      <!-- Article Body -->
      <article class="case-article">
        <!-- Section 1: Core Performance Metrics -->
        <section class="case-section" id="performance-metrics">
          <div class="section-tag">Empirical Benchmark Audit (Before vs. After)</div>
          <h2 id="performance-metrics">Core Web Vitals & Performance Metrics: From Sluggish WordPress to Custom Next.js 15</h2>
          
          <p>
            The comparative audit between the legacy WordPress implementation and webinOO's custom Next.js 15 architecture reveals an unprecedented performance leap across every Core Web Vitals metric:
          </p>

          <div class="data-table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Performance & Business Indicator</th>
                  <th>Pre-webinOO Baseline (Legacy WordPress)</th>
                  <th>Post-webinOO (Next.js 15 Edge)</th>
                  <th>Observed Improvement</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Largest Contentful Paint (LCP)</strong></td>
                  <td>4.8 seconds (Sluggish)</td>
                  <td><strong>0.68 seconds (Sub-800ms)</strong></td>
                  <td><span class="pill-growth">85% Speed Acceleration</span></td>
                </tr>
                <tr>
                  <td><strong>Interaction to Next Paint (INP / FID)</strong></td>
                  <td>220 ms</td>
                  <td><strong>18 ms</strong></td>
                  <td><span class="pill-growth">Instant Touch Response</span></td>
                </tr>
                <tr>
                  <td><strong>Cumulative Layout Shift (CLS)</strong></td>
                  <td>0.28 (Unstable Layout)</td>
                  <td><strong>0.000 (Rock-Solid Stability)</strong></td>
                  <td><span class="pill-growth">Perfect 100% Score</span></td>
                </tr>
                <tr>
                  <td><strong>Google PageSpeed Score (Mobile)</strong></td>
                  <td>34 / 100</td>
                  <td><strong>98 – 100 / 100</strong></td>
                  <td><span class="pill-growth">Algorithmic Preference</span></td>
                </tr>
                <tr>
                  <td><strong>Overall Conversion Rate (CR)</strong></td>
                  <td>2.4%</td>
                  <td><strong>6.8%</strong></td>
                  <td><span class="pill-growth">+183% Sales Conversation Lift</span></td>
                </tr>
                <tr>
                  <td><strong>Average Field Response Time</strong></td>
                  <td>45 minutes (Email Queue Lag)</td>
                  <td><strong>11.5 minutes (Telegram Webhook)</strong></td>
                  <td><span class="pill-growth">74% Faster Response Window</span></td>
                </tr>
                <tr>
                  <td><strong>Customer Acquisition Cost (CAC)</strong></td>
                  <td>High (Paid Ad Dependency)</td>
                  <td><strong>64% Cost Reduction</strong></td>
                  <td><span class="pill-growth">Free Organic Leads in 22+ Areas</span></td>
                </tr>
                <tr>
                  <td><strong>Ahrefs SEO Technical Audit Issues</strong></td>
                  <td>12 Structural Errors & Broken Links</td>
                  <td><strong>0 Errors (100% Perfect Score)</strong></td>
                  <td><span class="pill-growth">Flawless Canonical & Indexing</span></td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Loss Aversion Psychological Box -->
          <div class="psych-card loss-aversion">
            <div class="psych-title">
              <Zap size={20} />
              <span>Loss Aversion Principle: The True Cost of a $35 Wasted Click</span>
            </div>
            <p>
              In Kuwait's home services and pest control sector, Google Ads cost-per-click rates regularly reach 5 to 11 KWD ($15–$35). When an interested prospect taps an ad and the site takes 4+ seconds to load:
            </p>
            <ul>
              <li><strong>Direct Loss:</strong> Over 70% of mobile users abandon the page immediately — your budget is deducted while you receive zero leads.</li>
              <li><strong>Opportunity Loss:</strong> The prospect navigates back to Google and immediately books with a competitor whose website loaded instantly.</li>
              <li><strong>Engineering Solution:</strong> Compressing load time to 0.68s ensures every click lands directly in an interactive WhatsApp or phone conversion flow.</li>
            </ul>
          </div>
        </section>

        <!-- Section 2: Market Bottleneck & Business Challenges -->
        <section class="case-section" id="market-challenges">
          <div class="section-tag">Market Analysis & Dilemma</div>
          <h2 id="market-challenges">The Commercial Bottlenecks: Why Conventional Websites Fail in Kuwait's Service Market</h2>

          <p>
            Prior to partnering with webinOO, Demo Clean wrestled with three structural obstacles that crippled growth despite their elite field service quality:
          </p>

          <div class="challenges-grid">
            <div class="challenge-item">
              <h4>1. Escalating Google Ads PPC Costs</h4>
              <p>Aggressive bidding wars in Kuwait's pest control sector pushed click costs beyond $35, destroying profit margins when relying exclusively on paid search.</p>
            </div>
            <div class="challenge-item">
              <h4>2. Lethargic Communication Pathways</h4>
              <p>Conventional contact forms routed inquiries into slow email inboxes that took 45+ minutes to process — by which time prospects had hired a faster provider.</p>
            </div>
            <div class="challenge-item">
              <h4>3. Absence of Organic Local Dominance</h4>
              <p>Lacking programmatic district landing pages (Salmiya, Hawally, Farwaniya, Jahra, Ahmadi), the business forfeited thousands of high-intent organic searches daily.</p>
            </div>
          </div>
        </section>

        <!-- Section 3: Technical Architecture -->
        <section class="case-section" id="architecture">
          <div class="section-tag">High-Performance Architecture</div>
          <h2 id="architecture">The 5-Layer Engineering Architecture: Next.js 15 on Cloudflare Global Edge</h2>

          <p>
            Rather than deploying another bloated WordPress template, <strong>webinOO</strong> engineered <a href="https://democleankw.com" target="_blank" rel="dofollow" class="inline-store-link">democleankw.com</a> as an interconnected, high-velocity acquisition platform:
          </p>

          <div class="arch-layers-list">
            <div class="arch-layer-card">
              <div class="layer-num">Layer 1</div>
              <div class="layer-content">
                <h4>Next.js 15 Hybrid App Router Architecture</h4>
                <p>Static Site Generation (SSG) for all service and location hubs, coupled with React Server Components (RSC) to strip client-side JavaScript down to absolute zero for informational pages.</p>
              </div>
            </div>

            <div class="arch-layer-card">
              <div class="layer-num">Layer 2</div>
              <div class="layer-content">
                <h4>Cloudflare Edge Workers & Distributed KV Storage</h4>
                <p>Content distributed across regional edge nodes in Kuwait and the GCC, utilizing Cloudflare KV storage to retrieve articles and verified reviews in a blistering 15 to 30 milliseconds.</p>
              </div>
            </div>

            <div class="arch-layer-card">
              <div class="layer-num">Layer 3</div>
              <div class="layer-content">
                <h4>Zero-Trust Docker Container Hardening</h4>
                <p>Executed under an unprivileged user (non-root UID 10001), a completely read-only root filesystem, and dropped Linux capabilities to prevent script execution vulnerabilities.</p>
              </div>
            </div>

            <div class="arch-layer-card">
              <div class="layer-num">Layer 4</div>
              <div class="layer-content">
                <h4>Programmatic Local SEO Engine (35+ Hubs)</h4>
                <p>35+ specialized landing pages covering Kuwait's 6 governorates and 22+ residential districts, supported by a dynamic XML image sitemap and full Schema.org structured data.</p>
              </div>
            </div>

            <div class="arch-layer-card">
              <div class="layer-num">Layer 5</div>
              <div class="layer-content">
                <h4>Real-Time Field Dispatch Automation (Telegram Webhooks)</h4>
                <p>Custom bot webhook infrastructure delivering site inspection requests directly to mobile dispatch teams with 1-tap phone dial and contextual WhatsApp chat buttons.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Section 4: Operational Automation (Telegram & WhatsApp) -->
        <section class="case-section" id="telegram-automation">
          <div class="section-tag">Real-Time Field Automation</div>
          <h2 id="telegram-automation">The 11.5-Minute Response Window: Bypassing Email Delay with Telegram Webhook Bots</h2>

          <p>
            In urgent field services (such as emergency bed bug extermination or residential move-in cleaning), <strong>80% of contracts are awarded to the provider who responds first</strong>. Demo Clean's legacy email workflow caused a 45-minute delay that hemorrhaged prospective clients.
          </p>

          <div class="mobile-features-grid">
            <div class="mob-card">
              <h4>Sub-Second Push Notifications</h4>
              <p>The instant an inspection form is submitted, a secured webhook parses the payload and alerts the field dispatch room on Telegram with the customer's district, phone number, and service request.</p>
            </div>
            <div class="mob-card">
              <h4>1-Tap Actionable Inline Controls</h4>
              <p>Telegram bot messages feature direct [Instant Phone Call] and [Contextual WhatsApp] buttons, empowering field supervisors to initiate contact without manually transcribing numbers.</p>
            </div>
            <div class="mob-card">
              <h4>Intent-Aware Floating WhatsApp Buttons</h4>
              <p>Floating action triggers dynamically detect the current page content and pre-populate message text tailored to that specific district and service, elevating inquiry starts by over +140%.</p>
            </div>
          </div>
        </section>

        <!-- Section 5: Programmatic Local SEO Coverage -->
        <section class="case-section" id="programmatic-seo">
          <div class="section-tag">Organic Search Dominance</div>
          <h2 id="programmatic-seo">Programmatic Local SEO: Dominating 22+ Kuwait Districts with Zero Ad Spend</h2>

          <p>
            Instead of settling for a generic homepage, <strong>webinOO</strong> deployed a programmatic architecture capturing long-tail geographic search queries across Kuwait:
          </p>

          <div class="queries-comparison-grid">
            <div class="query-col">
              <h4>1. High-Intent Geographic Queries</h4>
              <p>Localized landing pages capturing ready-to-hire residential and commercial prospects:</p>
              <ul class="query-list">
                <li><code>Pest Control Salmiya (مكافحة حشرات السالمية)</code> — #1 Google organic ranking</li>
                <li><code>Residential Cleaning Farwaniya (تنظيف منازل الفروانية)</code> — Apartment complex demand</li>
                <li><code>Rodent Extermination Hawally (مكافحة قوارض حولي)</code> — Urgent emergency inquiries</li>
                <li><code>Marble Polishing Mubarak Al-Kabeer (جلي وتلميع رخام)</code> — High-ticket private villas</li>
                <li><code>Pest Control Jahra & Ahmadi (مكافحة حشرات الجهراء والأحمدي)</code> — Broad governorate reach</li>
              </ul>
            </div>

            <div class="query-col">
              <h4>2. Certified Commercial & Specialty Services</h4>
              <p>Specialized landing pages meeting stringent Ministry of Health and Municipality compliance standards:</p>
              <ul class="query-list">
                <li><code>Commercial Restaurant Pest Control (مكافحة حشرات المطاعم)</code> — Annual recurring B2B contracts</li>
                <li><code>Guaranteed Bed Bug Heat Treatment (رش بق الفراش بالضمان)</code> — High conversion emergency service</li>
                <li><code>Steam Carpet & Upholstery Sanitization (غسيل كنب وسجاد بالبخار)</code> — Holiday surge bookings</li>
                <li><code>Termite Soil Treatment (مكافحة النمل الأبيض والرمة)</code> — Foundation construction protection</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Section 6: AI Search & GEO Capabilities -->
        <section class="case-section" id="geo-tracker">
          <div class="section-tag">Generative Engine Optimization (GEO)</div>
          <h2 id="geo-tracker">AI Engine Tracking & GEO: Capturing Referrals from ChatGPT, Perplexity, and Gemini</h2>

          <p>
            As Kuwaiti consumers increasingly consult AI search assistants for certified service recommendations, <strong>webinOO</strong> equipped Demo Clean with cutting-edge conversational AI visibility:
          </p>

          <div class="ai-stats-banner">
            <div class="ai-stat-card">
              <span class="ai-stat-number">100%</span>
              <span class="ai-stat-title">AEO / GEO Snippet Extraction Readiness</span>
              <span class="ai-stat-detail">Structured, factual answer blocks engineered for direct verbatim quotation by Large Language Models</span>
            </div>
            <div class="ai-stat-card">
              <span class="ai-stat-number">5</span>
              <span class="ai-stat-title">Generative AI Engines Monitored Live</span>
              <span class="ai-stat-detail">Real-time referral tracking for visits originating from ChatGPT, Perplexity, Google Gemini, Claude, and Copilot</span>
            </div>
          </div>

          <p>
            The custom <code>AiAnalyticsTracker</code> module provides operational intelligence on the queries Kuwaiti consumers pose to generative engines, allowing webinOO to refine content and maintain Demo Clean as the premier AI-cited service provider in Kuwait.
          </p>
        </section>

        <!-- Section 7: Zero SaaS Fees & Custom CRM -->
        <section class="case-section" id="custom-crm">
          <div class="section-tag">Zero Recurring Software Fees</div>
          <h2 id="custom-crm">100% Software Expense Savings: Custom Self-Hosted CRM and Lightweight CMS</h2>

          <p>
            Rather than encumbering the client with thousands of dollars in annual subscriptions to third-party platforms like HubSpot or Contentful, webinOO built a custom, lightweight administrative suite:
          </p>

          <div class="geo-pillars-list">
            <div class="geo-pillar-item">
              <div class="pillar-bullet">1</div>
              <div>
                <h4>Lead Management CRM</h4>
                <p>A fast, encrypted portal managing all field inspection requests, pipeline stages (New, In Progress, Contract Signed, Deferred), and technician assignment metrics.</p>
              </div>
            </div>

            <div class="geo-pillar-item">
              <div class="pillar-bullet">2</div>
              <div>
                <h4>Markdown & JSON Content Publishing</h4>
                <p>A zero-bloat content management tool enabling instant educational article publishing with 1-click Markdown export for automated disaster recovery and backup.</p>
              </div>
            </div>

            <div class="geo-pillar-item">
              <div class="pillar-bullet">3</div>
              <div>
                <h4>Verified Customer Review Management</h4>
                <p>A direct moderation hub validating genuine client testimonials and connecting them to Schema.org Review structured data to boost Google search rich snippets.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Section 8: Client Testimonial -->
        <section class="case-section" id="client-testimonial">
          <div class="section-tag">Executive Testimonial</div>
          <h2 id="client-testimonial">What Demo Clean Executive Leadership Said About the Transformation</h2>

          <div class="takeaway-box" style="font-size: 16px; line-height: 1.9; border-left: 4px solid var(--color-primary, #6518ac); background: #ffffff; padding: 26px;">
            <p style="margin: 0 0 16px; color: var(--color-ink-primary, #292239); font-style: italic;">
              "Before working with webinOO, we were spending astronomical sums daily on Google Ads for pest control and cleaning, yet countless clicks went to waste due to our sluggish website and delayed responses to inspection requests. What webinOO delivered surpassed all expectations; the site loads in the blink of an eye, and the Telegram bot empowers our field crew to contact customers the very minute they submit an inquiry. Today, we enjoy a steady stream of organic daily calls from top Google rankings across Kuwait. Our website transformed from a marketing expense into our primary profit generator."
            </p>
            <strong style="color: var(--color-primary, #6518ac);">— Executive Management, Demo Clean Kuwait (democleankw.com)</strong>
          </div>
        </section>

        <!-- Section 9: Strategic Roadmap -->
        <section class="case-section" id="roadmap-90">
          <div class="section-tag">Future Growth Horizon</div>
          <h2 id="roadmap-90">Strategic Scaling Roadmap: Sustaining Long-Term Organic Dominance</h2>

