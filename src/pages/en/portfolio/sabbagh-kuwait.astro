      />
    </section>

    <!-- Floating Mobile Quick Action Bar -->
    <div class="case-mobile-bar" role="region" aria-label="Mobile quick actions">
      <a
        href="https://wa.me/201554637673?text=Hello%2C%20I%20reviewed%20the%20Sabbagh%20Kuwait%20case%20study%20and%20would%20like%20to%20discuss%20engineering%20a%20similar%20platform%20for%20my%20business."
        target="_blank"
        rel="noopener noreferrer"
        class="mob-cta-whatsapp"
      >
        <span>💬 WhatsApp Us</span>
      </a>
