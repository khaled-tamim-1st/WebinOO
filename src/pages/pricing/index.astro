---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import FAQ from '@/components/common/FAQ.astro';
import CTA from '@/components/common/CTA.astro';
import { getWhatsAppUrl } from '@/data/business';
import { Check, ArrowLeft } from '@lucide/astro';

const breadcrumbs = [
  { label: 'الرئيسية', href: '/' },
  { label: 'باقات الأسعار' },
];

const packages = [
  {
    name: 'باقة الانطلاق',
    badge: 'للأنشطة والخدمات الفردية',
    highlight: false,
    desc: 'موقع تعريفي سريع وأنيق يثبت حضورك على الإنترنت ويبدأ في استقبال طلبات الواتساب مباشرة.',
    features: [
      'تصميم صفحة رئيسية متكاملة (One-Page) فائقة السرعة',
      'متوافق 100% مع الجوال والتابلت',
      'زر واتساب واتصال مباشر ذكي',
      'ربط خريطة Google وموقعك في الكويت',
      'شهادة أمان SSL واستضافة سريعة لمدة سنة',
      'تسليم خلال 7 إلى 10 أيام عمل',
    ],
    ctaText: 'استفسر عن باقة الانطلاق',
    message: 'السلام عليكم، أود معرفة تفاصيل وعرض سعر باقة الانطلاق في webinOO.',
  },
  {
    name: 'باقة الأعمال والـ SEO',
    badge: 'الأكثر طلباً للشركات في الكويت',
    highlight: true,
    desc: 'موقع متعدد الصفحات مهيأ لمحركات البحث (SEO) والذكاء الاصطناعي لجلب عملاء مستمرين.',
    features: [
      'موقع من 5 إلى 8 صفحات مخصصة للخدمات والأعمال',
      'هندسة متقدمة لمحركات البحث (SEO Core + Schemas)',
      'تهيئة الظهور في محركات الذكاء الاصطناعي (GEO Ready)',
      'إدارة ملف خرائط Google وربط المناطق السكنية',
      'صياغة محتوى عربي تسويقي يناسب عملاء الكويت',
      'لوحة تحكم لإضافة وتعديل المشاريع بسهولة',
      'دعم فني وصيانة مجانية لمدة 3 أشهر',
    ],
    ctaText: 'اطلب باقة الأعمال المتقدمة',
    message: 'السلام عليكم، أود طلب باقة الأعمال والـ SEO لشركتي في الكويت.',
  },
  {
    name: 'باقة النظم والمتاجر',
    badge: 'للتجارة والحلول البرمجية',
    highlight: false,
    desc: 'متجر إلكتروني متكامل أو تطبيق ويب مبرمج خصيصاً مع بوابات الدفع والربط المحلي.',
    features: [
      'متجر إلكتروني أو نظام ويب مبرمج بدون قوالب جاهزة',
      'ربط بوابات الدفع الكويتية (كي نت Knet و Apple Pay)',
      'إدارة المنتجات والمخزون وحسابات العملاء',
      'سرعة فائقة للشراء في أقل من 40 ثانية',
      'تقارير مبيعات وتحليلات زوار تفصيلية',
      'دعم فني وتطوير مستمر',
    ],
    ctaText: 'ناقش حلاً مخصصاً لمتجرك',
    message: 'السلام عليكم، أود مناقشة حل برمجي أو متجر إلكتروني مخصص لنشاطي.',
  },
];

const pricingFaqs = [
  {
    question: 'كيف يتم دفع تكاليف المشروع؟',
    answer: 'نعتمد نظام دفعات عادل ومريح: 50% دفعة أولى عند توقيع العقد والبدء، و50% المتبقية بعد معاينة الموقع واعتماده وقبل الإطلاق الرسمي.',
  },
  {
    question: 'هل توجد أي رسوم شهرية خفية بعد استلام الموقع؟',
    answer: 'لا توجد أي رسوم خفية على الإطلاق. الموقع ملكك بالكامل. الرسوم السنوية الوحيدة بعد العام الأول هي تجديد الاستضافة السحابية والدومين بأسعار رمزية ومحددة سلفاً.',
  },
  {
    question: 'ما هي طرق الدفع المتاحة للشركات في الكويت؟',
    answer: 'نوفر الدفع عبر روابط كي نت (Knet)، التحويل البنكي المباشر لحساب الشركة، أو الشيكات المصدقة للشركات والمؤسسات.',
  },
  {
    question: 'ماذا لو رغبت في تعديل أو إضافة صفحات مستقبلاً؟',
    answer: 'نوفر خطط صيانة مرنة ودعماً سريعاً بالساعة أو بالطلب لتوسيع موقعك وإضافة أي مزايا جديدة مع نمو شركتك.',
  },
];
---

<BaseLayout
  title="باقات وأسعار تصميم المواقع والـ SEO في الكويت | webinOO"
  description="باقات أسعار واضحة وشفافة لتصميم المواقع وتحسين محركات البحث في الكويت. استثمار ذكي ومدروس يضمن لك عائداً حقيقياً ومبيعات مستمرة."
  lang="ar"
>
  <Header slot="header" lang="ar" />

  <main class="pricing-page">
    <section class="container page-header">
      <Breadcrumbs items={breadcrumbs} />
      <div class="eyebrow">استثمار شفاف بدون مفاجآت</div>
      <h1>باقات مدروسة لتنمية أعمالك في الكويت</h1>
      <p class="page-lead">
        نقدم لك قيمة حقيقية مقابل استثمارك. كل باقة تشمل تصميماً أصلياً من الصفر، كوداً سريعاً، وأساساً تقنياً متيناً يضمن لك التميز عن المنافسين.
      </p>
    </section>

    <!-- Pricing Cards Grid -->
    <section class="container packages-section">
      <div class="packages-grid">
        {
          packages.map((pkg) => {
            const btnHref = getWhatsAppUrl(pkg.message);
            return (
              <div class={`pkg-card ${pkg.highlight ? 'pkg-highlight' : ''}`}>
                {pkg.highlight && <div class="popular-ribbon">الخيار الموصى به</div>}
                <div class="pkg-header">
                  <span class="pkg-badge">{pkg.badge}</span>
                  <h2>{pkg.name}</h2>
                  <p class="pkg-desc">{pkg.desc}</p>
                </div>

                <div class="pkg-features">
                  <div class="features-title">ما تشمله الباقة:</div>
                  <ul>
                    {pkg.features.map((feat) => (
                      <li>
                        <Check size={16} class="check-icon" />
                        <span>{feat}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="pkg-action">
                  <a
                    href={btnHref}
                    class={`button ${pkg.highlight ? 'button-primary' : 'button-quiet'}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    style="width: 100%;"
                  >
                    {pkg.ctaText} <ArrowLeft size={16} />
                  </a>
                </div>
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- Pricing FAQ -->
    <FAQ
      eyebrow="وضوح مالي تام"
      title="أسئلة شائعة حول الأسعار والدفع"
      description="إجابات صريحة عن طرق السداد والتكاليف والضمانات."
      items={pricingFaqs}
      id="pricing-faq"
    />

    <!-- Custom Quote CTA -->
    <CTA
      eyebrow="لديك متطلبات خاصة لا تغطيها الباقات؟"
      title="احصل على عرض سعر مفصل وثابت لمشروعك."
      description="تواصل معنا وسنقدم لك استشارة مجانية وعرض سعر شفاف يحدد كل بند قبل أن تدفع فلساً واحداً."
      ctaText="اطلب عرض سعر مخصص"
      whatsappMessage="السلام عليكم، أود طلب عرض سعر مفصل لمشروع موقع جديد."
    />
  </main>

  <Footer slot="footer" lang="ar" />
</BaseLayout>

<style>
  .pricing-page {
    padding: 30px 0 60px;
  }
  .page-header {
    max-width: 820px;
    margin-bottom: 50px;
  }
  .page-header h1 {
    font-size: clamp(34px, 4.5vw, 56px);
    line-height: 1.25;
    letter-spacing: -0.04em;
    margin: 16px 0;
    color: var(--color-ink-primary, #292239);
  }
  .page-lead {
    font-size: 18px;
    line-height: 1.9;
    color: var(--color-ink-muted, #716b7a);
  }
  .packages-section {
    margin-bottom: 80px;
  }
  .packages-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    align-items: stretch;
  }
  .pkg-card {
    background: var(--color-bg-card, #fffefa);
    border: 1px solid var(--color-border-subtle, #eee7f0);
    border-radius: var(--radius-lg, 24px);
    padding: 40px 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    box-shadow: 0 4px 15px rgba(56, 32, 75, 0.03);
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .pkg-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card, 0 16px 38px rgba(56, 32, 75, 0.09));
  }
  .pkg-highlight {
    border: 2px solid var(--color-primary, #6518ac);
    background: #fff;
    box-shadow: 0 20px 45px rgba(101, 24, 172, 0.12);
    transform: scale(1.02);
  }
  .popular-ribbon {
    position: absolute;
    top: -14px;
    inset-inline-start: 50%;
    transform: translateX(50%);
    background: var(--color-primary, #6518ac);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    padding: 6px 18px;
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 12px rgba(101, 24, 172, 0.3);
  }
  .pkg-header {
    margin-bottom: 24px;
  }
  .pkg-badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-primary-text, #6b1eae);
    background: var(--color-primary-light, #eee5f5);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    margin-bottom: 14px;
  }
  .pkg-header h2 {
    font-size: 24px;
    margin: 0 0 12px;
    color: var(--color-ink-primary, #292239);
  }
  .pkg-desc {
    font-size: 14px;
    line-height: 1.8;
    color: var(--color-ink-muted, #716b7a);
    margin: 0;
  }
  .pkg-features {
    padding: 24px 0;
    border-top: 1px solid var(--color-border-subtle, #eee7f0);
    border-bottom: 1px solid var(--color-border-subtle, #eee7f0);
    margin-bottom: 28px;
    flex-grow: 1;
  }
  .features-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-ink-primary, #292239);
    margin-bottom: 16px;
  }
  .pkg-features ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pkg-features li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    color: var(--color-ink-secondary, #595264);
    line-height: 1.6;
  }
  .check-icon {
    color: var(--color-accent-green, #66a28b);
    flex-shrink: 0;
    margin-top: 3px;
  }
  @media (max-width: 980px) {
    .packages-grid {
      grid-template-columns: 1fr;
    }
    .pkg-highlight {
      transform: none;
    }
  }
</style>
